<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:app="clr-namespace:SwiftList.App"
                    xmlns:converters="clr-namespace:SwiftList.App.Converters">
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="../Styles/Colors.xaml"/>
	</ResourceDictionary.MergedDictionaries>

	<!-- ═══════════ Self-Drawn Action Context Menu Item Template ═══════════ -->
	<DataTemplate x:Key="ActionMenuItemTemplate" DataType="{x:Type app:ActionMenuItem}">
		<Grid VerticalAlignment="Center">
			<!-- Separator view -->
			<Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SeparatorBrush}" Height="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,4"
                    Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVis}}"/>

			<!-- Height explicitly matches a normal row's own ItemHeight/ScaledItemHeight: this template
			     root Grid is VerticalAlignment="Center" (not the default Stretch), so when everything
			     else is collapsed (a header shows only this text), the row sizes to this element's own
			     height rather than stretching to fill whatever the container's MinHeight provides.
			     ActionMenuBuilder now also sets a header ActionMenuItem's own ItemHeight equal to a
			     normal item's (previously a shorter, independently-derived value), so both the data and
			     this explicit binding agree on the same number. Height lives on this wrapping Border
			     rather than the TextBlock itself: a TextBlock given an explicit Height taller than its
			     own text renders that text top-aligned regardless of its own VerticalAlignment (that
			     property positions the TextBlock's own box within ITS parent, not the text within the
			     box): wrapping it is what lets VerticalAlignment="Center" on the TextBlock actually
			     center the text within the now-taller row. -->
			<Border Visibility="{Binding SectionHeaderVisibility}">
				<Border.Style>
					<Style TargetType="Border">
						<Setter Property="Height" Value="{Binding ItemHeight}"/>
						<Style.Triggers>
							<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=Title}" Value="SwiftList">
								<Setter Property="Height" Value="{Binding ScaledItemHeight}"/>
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Border.Style>
				<TextBlock Text="{Binding SectionTitle}" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBlue}" VerticalAlignment="Center"
                       Margin="0">
					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Setter Property="FontSize" Value="12"/>
							<Style.Triggers>
								<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=Title}" Value="SwiftList">
									<Setter Property="FontSize" Value="{Binding ScaledSectionFontSize}"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>
			</Border>

			<!-- Menu item view -->
			<Grid Visibility="{Binding IsNormalItem, Converter={StaticResource BoolToVis}}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<!-- Item Icon -->
				<Image Grid.Column="0" Source="{Binding Icon}" Stretch="Uniform" Margin="8,0,8,0" VerticalAlignment="Center"
                       Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality">
					<Image.Style>
						<Style TargetType="Image">
							<Setter Property="Width" Value="16"/>
							<Setter Property="Height" Value="16"/>
							<Style.Triggers>
								<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=Title}" Value="SwiftList">
									<Setter Property="Width" Value="{Binding ScaledIconSize}"/>
									<Setter Property="Height" Value="{Binding ScaledIconSize}"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Image.Style>
				</Image>

				<!-- Placeholder bullet when no icon -->
				<Ellipse Grid.Column="0" Width="4" Height="4" Fill="{DynamicResource FileIconColor}" Margin="14,0,14,0" VerticalAlignment="Center"
                         Visibility="{Binding PlaceholderVisibility}"/>

				<TextBlock Grid.Column="1" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimary}"
                           converters:TextHighlighter.Text="{Binding Text}"
                           converters:TextHighlighter.HighlightText="{Binding SearchQuery}"
                           converters:TextHighlighter.HighlightBrush="{DynamicResource AccentBlue}"
                           TextTrimming="CharacterEllipsis">
					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Setter Property="FontSize" Value="13"/>
							<Style.Triggers>
								<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=Title}" Value="SwiftList">
									<Setter Property="FontSize" Value="{Binding ScaledTextFontSize}"/>
								</DataTrigger>
								<DataTrigger Binding="{Binding IsCompact}" Value="True">
									<Setter Property="FontSize" Value="12.5"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>

				<!-- Keyboard shortcut hint: same pill badge as SearchResultTemplate (DataTemplates.xaml),
				     reusing HoverBackground/ShortcutColor/AccentBlue rather than new themed resources.
				     Selected/highlighted switches to an AccentBlue border + text instead of an outline in
				     SeparatorBrush (see that template's own comment: SeparatorBrush and the row's own
				     selected background are nearly the same color in the Light theme, so that outline
				     barely showed).
				     Driven by the ActionMenuItem's own IsSelected flag (plain DataContext binding, no
				     RelativeSource) rather than ListBoxItem.IsSelected via AncestorType: that pattern
				     works fine for the results list's own badge, but here it rendered every row as
				     permanently selected (root cause not pinned down); IsSelected is kept in sync
				     explicitly by LstActions.SelectionChanged (see ShellMenuPresenter). The MenuItem
				     flyout variant (ActionFlyoutMenuItemStyle below) still reacts correctly via
				     MenuItem.IsHighlighted, which was never broken. -->
				<Border Grid.Column="2"
                        Margin="14,0,0,0"
                        Padding="7,3,7,3"
                        CornerRadius="4"
                        BorderThickness="1"
                        VerticalAlignment="Center">
					<Border.Style>
						<Style TargetType="Border">
							<Setter Property="Visibility" Value="Visible"/>
							<Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
							<Setter Property="BorderBrush" Value="Transparent"/>
							<Style.Triggers>
								<DataTrigger Binding="{Binding ShortcutHint}" Value="">
									<Setter Property="Visibility" Value="Collapsed"/>
								</DataTrigger>
								<DataTrigger Binding="{Binding ShortcutHint}" Value="{x:Null}">
									<Setter Property="Visibility" Value="Collapsed"/>
								</DataTrigger>
								<DataTrigger Binding="{Binding IsSelected}" Value="True">
									<Setter Property="Background" Value="Transparent"/>
									<Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
								</DataTrigger>
								<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}, Path=IsHighlighted}" Value="True">
									<Setter Property="Background" Value="Transparent"/>
									<Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Border.Style>
					<TextBlock Text="{Binding ShortcutHint}"
                               VerticalAlignment="Center">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="FontSize" Value="11"/>
								<Setter Property="Foreground" Value="{DynamicResource ShortcutColor}"/>
								<Style.Triggers>
									<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=Title}" Value="SwiftList">
										<Setter Property="FontSize" Value="{Binding ScaledShortcutFontSize}"/>
									</DataTrigger>
									<DataTrigger Binding="{Binding IsSelected}" Value="True">
										<Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
									</DataTrigger>
									<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}, Path=IsHighlighted}" Value="True">
										<Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
				</Border>

				<!-- Submenu indicator -->
				<Path Grid.Column="3" Data="M0,0 L5,4 L0,8 Z" Fill="{DynamicResource ShortcutColor}" Width="5" Height="8" Stretch="Uniform" VerticalAlignment="Center" Margin="10,0,0,0"
                      Visibility="{Binding HasSubMenu, Converter={StaticResource BoolToVis}}"/>
			</Grid>
		</Grid>
	</DataTemplate>

	<!-- ═══════════ Flyout MenuItem that renders identically to the actions list row ═══════════ -->
	<!-- Used by the quick-nav right-click menu (PluginContextMenuHelper) so its rows are pixel-identical
	     to the self-drawn actions list: same ActionMenuItemTemplate content + same container chrome as
	     ActionItemStyle (rounded highlight, margins, height, AccentBar), while keeping MenuItem
	     submenu/keyboard. Highlight color used to be SelectedBackground (a themed blue tint distinct
	     from the plain actions list's gray HoverBackground): same action, two different highlight
	     colors depending on which surface showed it. Unified to HoverBackground + the same left accent
	     bar ActionItemStyle uses, so the flyout and the plain list read as the exact same control. -->
	<Style x:Key="ActionFlyoutMenuItemStyle" TargetType="{x:Type MenuItem}">
		<Setter Property="HeaderTemplate" Value="{StaticResource ActionMenuItemTemplate}"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type MenuItem}">
					<Grid>
						<Rectangle x:Name="AccentBar" Width="3" HorizontalAlignment="Left"
						           RadiusX="1.5" RadiusY="1.5" Fill="Transparent" Margin="0,2"/>
						<Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Margin="6,2,6,2" Padding="12,0,12,0" VerticalAlignment="Stretch">
							<ContentPresenter ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
						</Border>
						<Popup x:Name="PART_Popup"
						       Placement="Right"
						       AllowsTransparency="True"
						       Focusable="False"
						       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
						       PopupAnimation="Fade">
							<Border Background="{DynamicResource MenuBackground}"
							        BorderBrush="{DynamicResource MenuBorderBrush}"
							        BorderThickness="1"
							        CornerRadius="8"
							        Padding="6"
							        SnapsToDevicePixels="True">
								<Border.Effect>
									<DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="{DynamicResource ShadowColor}" Opacity="0.08"/>
								</Border.Effect>
								<ScrollViewer Focusable="false">
									<ItemsPresenter KeyboardNavigation.TabNavigation="Cycle"/>
								</ScrollViewer>
							</Border>
						</Popup>
					</Grid>
					<ControlTemplate.Triggers>
						<!-- Single highlight color for both mouse hover and keyboard selection (WPF sets
						     IsHighlighted for both), matching the classic shell menu; avoids the flicker a
						     separate IsMouseOver trigger caused when mouse-move events are swallowed. -->
						<Trigger Property="IsHighlighted" Value="True">
							<Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
							<Setter TargetName="AccentBar" Property="Fill" Value="{DynamicResource AccentBarColor}"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>
