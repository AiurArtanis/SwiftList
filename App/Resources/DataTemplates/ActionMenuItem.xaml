<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:app="clr-namespace:SwiftList.App">
	<ResourceDictionary.MergedDictionaries>
		<ResourceDictionary Source="../Styles/Colors.xaml"/>
	</ResourceDictionary.MergedDictionaries>

	<!-- ═══════════ Self-Drawn Action Context Menu Item Template ═══════════ -->
	<DataTemplate x:Key="ActionMenuItemTemplate" DataType="{x:Type app:ActionMenuItem}">
		<Grid>
			<Grid.Style>
				<Style TargetType="Grid">
					<Setter Property="Height" Value="{Binding ItemHeight}"/>
				</Style>
			</Grid.Style>

			<!-- Separator view -->
			<Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SeparatorBrush}" Height="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,4"
                    Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVis}}"/>

			<!-- Section Header view (e.g. "Context Menu") -->
			<TextBlock Text="{Binding SectionTitle}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBlue}" VerticalAlignment="Center"
                       
                       Margin="0,4,0,0"
                       Visibility="{Binding SectionHeaderVisibility}"/>

			<!-- Menu item view -->
			<Grid Visibility="{Binding IsNormalItem, Converter={StaticResource BoolToVis}}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<!-- Item Icon -->
				<Image Grid.Column="0" Source="{Binding Icon}" Width="16" Height="16" Stretch="Uniform" Margin="8,0,8,0" VerticalAlignment="Center"
                       Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality"/>

				<!-- Placeholder bullet when no icon -->
				<Ellipse Grid.Column="0" Width="4" Height="4" Fill="{DynamicResource FileIconColor}" Margin="14,0,14,0" VerticalAlignment="Center"
                         Visibility="{Binding PlaceholderVisibility}"/>

				<TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimary}"
                           
                           TextTrimming="CharacterEllipsis"/>

				<!-- Submenu indicator -->
				<Path Grid.Column="2" Data="M0,0 L5,4 L0,8 Z" Fill="{DynamicResource ShortcutColor}" Width="5" Height="8" Stretch="Uniform" VerticalAlignment="Center" Margin="10,0,0,0"
                      Visibility="{Binding HasSubMenu, Converter={StaticResource BoolToVis}}"/>
			</Grid>
		</Grid>
	</DataTemplate>

</ResourceDictionary>
