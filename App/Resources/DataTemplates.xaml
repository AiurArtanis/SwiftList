<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:app="clr-namespace:SwiftList.App"
                    xmlns:local="clr-namespace:SwiftList.App.Converters"
                    xmlns:helpers="clr-namespace:SwiftList.App.Helpers">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles/Colors.xaml"/>
        <ResourceDictionary Source="DataTemplates/InlineSearchResult.xaml"/>
        <ResourceDictionary Source="DataTemplates/ActionMenuItem.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ═══════════ Search Result Item Template ═══════════ -->
    <DataTemplate x:Key="SearchResultTemplate" DataType="{x:Type app:AppSearchResult}">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Icon -->
                <ColumnDefinition Width="Auto"/>
                <!-- Name + Path -->
                <ColumnDefinition Width="*"/>
                <!-- Shortcut badge -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.ColumnSpan="3"
                       FontSize="12"
                       FontWeight="SemiBold"
                       
                       Foreground="{DynamicResource AccentBlue}"
                       VerticalAlignment="Center"
                       Text="{Binding Name}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSearchSectionHeader}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- File/Folder icon -->
            <Image Grid.Column="0" Source="{Binding Icon}" Margin="0,0,14,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Setter Property="Width" Value="{Binding ResultIconSize}"/>
                        <Setter Property="Height" Value="{Binding ResultIconSize}"/>
                        <Style.Triggers>
                            <!-- Quick window only: icons scale with the search box height. -->
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=Title}" Value="SwiftList">
                                <Setter Property="Width" Value="{Binding ScaledResultIconSize}"/>
                                <Setter Property="Height" Value="{Binding ScaledResultIconSize}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEmptyResult}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSearchSectionHeader}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsListItem}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>

            <!-- Name + directory path -->
            <StackPanel VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Grid.Column" Value="1"/>
                        <Setter Property="Grid.ColumnSpan" Value="1"/>
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmptyResult}" Value="True">
                                <Setter Property="Grid.Column" Value="0"/>
                                <Setter Property="Grid.ColumnSpan" Value="3"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSearchSectionHeader}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsListItem}" Value="True">
                                <Setter Property="Grid.Column" Value="0"/>
                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False"
                              local:ScrollViewerHelper.BubbleMouseWheel="True">
                    <TextBlock 
                               Foreground="{DynamicResource TextPrimary}"
                               local:TextHighlighter.Text="{Binding Name}"
                               local:TextHighlighter.HighlightText="{Binding SearchQuery}"
                               local:TextHighlighter.HighlightBrush="{DynamicResource AccentBlue}"
                               helpers:MarqueeBehavior.EnableMarquee="True">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="{Binding NameFontSize}"/>
                                <Setter Property="TextAlignment" Value="Left"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="TextTrimming" Value="None"/>
                                <Style.Triggers>
                                    <!-- Quick window only: name text scales with the search box height. -->
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=Title}" Value="SwiftList">
                                        <Setter Property="FontSize" Value="{Binding ScaledNameFontSize}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsEmptyResult}" Value="True">
                                        <Setter Property="FontSize" Value="24"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </ScrollViewer>
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False" Margin="0,2,0,0"
                              local:ScrollViewerHelper.BubbleMouseWheel="True">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsApplication}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <!-- Blank subtitle (e.g. applications) shows name-only: hide the empty row. -->
                                <DataTrigger Binding="{Binding ParentDir}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEmptyResult}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <TextBlock Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Left"
                               helpers:MarqueeBehavior.EnableMarquee="True"
                               local:TextHighlighter.Text="{Binding ParentDir}"
                               local:TextHighlighter.HighlightText="{Binding SearchQuery}"
                               local:TextHighlighter.HighlightBrush="{DynamicResource AccentBlue}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="{Binding PathFontSize}"/>
                                <Style.Triggers>
                                    <!-- Quick window only: path text scales with the search box height. -->
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=Title}" Value="SwiftList">
                                        <Setter Property="FontSize" Value="{Binding ScaledPathFontSize}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </ScrollViewer>
            </StackPanel>

            <!-- Keyboard shortcut hint: a pill-shaped badge (Flow Launcher style) rather than bare text,
                 reusing HoverBackground/ShortcutColor/AccentBlue (already defined in every theme) instead
                 of introducing new themed resources every theme file would need to add too.
                 Filled with HoverBackground normally, but the row's OWN selected background is that same
                 color (ResultItemStyle in ListBox.xaml): filled-on-filled made the badge disappear
                 entirely on a selected row. An outline in SeparatorBrush was tried next, but that brush
                 (#E5E5E5) sits almost on top of HoverBackground (#E8E8E8) in the Light theme, so it barely
                 read as a border either: selected now switches to AccentBlue (the same color the row's
                 own left accent bar lights up with) for both the border and the text, which reads clearly
                 against any theme's hover/selection background. -->
            <Border Grid.Column="2"
                    Margin="14,0,0,0"
                    Padding="7,3,7,3"
                    CornerRadius="4"
                    BorderThickness="1"
                    VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="{Binding ShortcutVisibility}"/>
                        <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmptyResult}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSearchSectionHeader}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ShortcutHint}"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Foreground" Value="{DynamicResource ShortcutColor}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
