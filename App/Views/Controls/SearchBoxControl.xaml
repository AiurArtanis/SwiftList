<UserControl x:Class="SwiftList.App.SearchBoxControl"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:services="clr-namespace:SwiftList.App.Services"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="600">
    
    <Grid>
            <Grid.ColumnDefinitions>
                <!-- Left Icon Column -->
                <ColumnDefinition Width="Auto"/>
                <!-- Actions Label Column -->
                <ColumnDefinition Width="Auto"/>
                <!-- TextBox Column -->
                <ColumnDefinition Width="*"/>
                <!-- Right Icon Column -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left Icon Grid (Visible only when IsIconOnLeft is True) -->
            <Grid Grid.Column="0" Margin="0,0,11,0" VerticalAlignment="Center" MouseRightButtonUp="Icon_MouseRightButtonUp">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsIconOnLeft, ElementName=root}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsInActionsMode, ElementName=root}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <!-- Monochrome logo icon -->
                <Border Width="{Binding LeftIconSize, ElementName=root}" Height="{Binding LeftIconSize, ElementName=root}" SnapsToDevicePixels="True" UseLayoutRounding="True" RenderOptions.BitmapScalingMode="HighQuality">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="Background" Value="{DynamicResource TextSecondary}"/>
                            <Setter Property="Opacity" Value="0.5"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsServiceRunning, ElementName=root}" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                    <Setter Property="Opacity" Value="0.8"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.OpacityMask>
                        <ImageBrush ImageSource="pack://application:,,,/SwiftList.App;component/tray.png"
                                    RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border.OpacityMask>
                </Border>
                <!-- Loading spinner -->
                <Control Width="{Binding LeftIconSize, ElementName=root}" Height="{Binding LeftIconSize, ElementName=root}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Control.Style>
                        <Style TargetType="Control" BasedOn="{StaticResource ModernSpinnerStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Tag" Value="{DynamicResource AccentBlue}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Control.Style>
                </Control>
            </Grid>

            <!-- Actions Label -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,11,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInActionsMode, ElementName=root}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_ActionsTitle]}" 
                           FontWeight="SemiBold" Foreground="{DynamicResource AccentBlue}" FontSize="{Binding FontSize, ElementName=root}"/>
                <!-- Vertical divider line -->
                <Border Width="1" Height="16" Margin="11,0,0,0" Background="{DynamicResource SeparatorBrush}" SnapsToDevicePixels="True"/>
            </StackPanel>

            <!-- TextBox -->
            <TextBox x:Name="TxtSearch"
                     Grid.Column="2"
                     Text="{Binding SearchText, ElementName=root, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="{Binding FontSize, ElementName=root}"
                     
                     Foreground="{DynamicResource TextPrimary}"
                     Background="Transparent"
                     BorderThickness="0"
                     VerticalAlignment="Center"
                     CaretBrush="{DynamicResource TextPrimary}"/>

            <!-- Placeholder -->
            <TextBlock x:Name="TxtPlaceholder"
                       Grid.Column="2"
                       FontSize="{Binding FontSize, ElementName=root}"
                       Foreground="{DynamicResource TextSecondary}"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickSearch_Placeholder]}"/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsInActionsMode, ElementName=root}" Value="True">
                                <Setter Property="Text" Value="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_ActionsSearchPlaceholder]}"/>
                            </DataTrigger>
                            <!-- Quick window only, opt-in (General settings > Layout, see issue #101): while
                                 the box is empty there's nothing useful to type-hint about, so the clock takes
                                 over the same slot instead of adding a separate element elsewhere. Binds
                                 straight to the ambient DataContext (QuickSearchViewModel), matching how
                                 IsSearching elsewhere in this control already does the same. FallbackValue
                                 keeps this a no-op in SearchWindow, whose DataContext (SearchViewModel)
                                 doesn't expose ClockVisibility at all; InlineSearchWindow DOES share
                                 QuickSearchViewModel, so it needs ClockVisibility's own IsInlineSearchContext
                                 check instead to stay excluded. -->
                            <DataTrigger Binding="{Binding ClockVisibility, FallbackValue=Collapsed}" Value="Visible">
                                <Setter Property="Text" Value="{Binding ClockText}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Right Icon Grid (Visible only when IsIconOnLeft is False) -->
            <Grid Grid.Column="3" Margin="11,0,0,0" VerticalAlignment="Center" MouseRightButtonUp="Icon_MouseRightButtonUp">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsIconOnLeft, ElementName=root}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsInActionsMode, ElementName=root}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <!-- Monochrome logo icon -->
                <Border Width="{Binding RightIconSize, ElementName=root}" Height="{Binding RightIconSize, ElementName=root}" SnapsToDevicePixels="True" UseLayoutRounding="True" RenderOptions.BitmapScalingMode="HighQuality">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="Background" Value="{DynamicResource TextSecondary}"/>
                            <Setter Property="Opacity" Value="0.6"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsServiceRunning, ElementName=root}" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                    <Setter Property="Opacity" Value="0.8"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.OpacityMask>
                        <ImageBrush ImageSource="pack://application:,,,/SwiftList.App;component/tray.png"
                                    RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border.OpacityMask>
                </Border>
     
                <!-- Loading spinner -->
                <Control Width="{Binding RightIconSize, ElementName=root}" Height="{Binding RightIconSize, ElementName=root}">
                    <Control.Style>
                        <Style TargetType="Control" BasedOn="{StaticResource ModernSpinnerStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Tag" Value="{DynamicResource AccentBlue}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Control.Style>
                </Control>
            </Grid>
        </Grid>
</UserControl>
