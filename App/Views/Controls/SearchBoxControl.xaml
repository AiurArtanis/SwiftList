<UserControl x:Class="SwiftList.App.SearchBoxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:services="clr-namespace:SwiftList.App.Services"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="600">
    
    <Grid Margin="21,19,21,19">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- TextBox -->
        <TextBox x:Name="TxtSearch"
                 Grid.Column="0"
                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="24"
                 FontFamily="Microsoft YaHei UI, Segoe UI"
                 Foreground="{DynamicResource TextPrimary}"
                 Background="Transparent"
                 BorderThickness="0"
                 VerticalAlignment="Center"
                 CaretBrush="{DynamicResource TextPrimary}"/>

        <!-- Placeholder -->
        <TextBlock x:Name="TxtPlaceholder"
                   Grid.Column="0"
                   Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickSearch_Placeholder]}"
                   FontSize="24"
                   FontFamily="Microsoft YaHei UI, Segoe UI"
                   Foreground="{DynamicResource TextSecondary}"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Search icon (magnifier) / Spinner loader -->
        <Grid Grid.Column="1">
            <!-- Magnifier icon -->
            <Viewbox Width="29" Height="29" Margin="11,0,0,0" Opacity="0.6">
                <Viewbox.Style>
                    <Style TargetType="Viewbox">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Viewbox.Style>
                <Canvas Width="24" Height="24">
                    <Path Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                          Fill="{DynamicResource TextSecondary}"/>
                </Canvas>
            </Viewbox>
 
            <!-- Loading spinner -->
            <Control Width="27" Height="27" Margin="11,0,0,0">
                <Control.Style>
                    <Style TargetType="Control" BasedOn="{StaticResource ModernSpinnerStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Control.Style>
            </Control>
        </Grid>
 
        <!-- Open full search window -->
        <Button x:Name="BtnOpenMore"
                Grid.Column="2"
                Width="29"
                Height="29"
                Margin="13,0,0,0"
                Padding="0"
                VerticalAlignment="Center"
                ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickSearch_OpenMore]}"
                Cursor="Hand"
                Background="{DynamicResource BadgeBackground}"
                BorderBrush="{DynamicResource BadgeBorderBrush}"
                BorderThickness="1">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="14.5"/>
                </Style>
            </Button.Resources>
            <Viewbox Width="16" Height="16" Opacity="0.85">
                <Canvas Width="24" Height="24">
                    <Path Data="M7 7h10v10h-2V10.41l-8.29 8.3-1.42-1.42 8.3-8.29H7V7z"
                          Fill="{DynamicResource BadgeText}"/>
                </Canvas>
            </Viewbox>
        </Button>
    </Grid>
</UserControl>
