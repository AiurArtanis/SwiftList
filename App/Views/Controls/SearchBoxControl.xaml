<UserControl x:Class="SwiftList.App.SearchBoxControl"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:services="clr-namespace:SwiftList.App.Services"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="600">
    
    <Grid>
            <Grid.ColumnDefinitions>
                <!-- Left Icon Column -->
                <ColumnDefinition Width="Auto"/>
                <!-- TextBox Column -->
                <ColumnDefinition Width="*"/>
                <!-- Right Icon Column -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left Icon Grid (Visible only when IsIconOnLeft is True) -->
            <Grid Grid.Column="0" Margin="0,0,11,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsIconOnLeft, ElementName=root}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <!-- Magnifier icon -->
                <Viewbox Width="20" Height="20" Opacity="0.5">
                    <Viewbox.Style>
                        <Style TargetType="Viewbox">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Viewbox.Style>
                    <Canvas Width="24" Height="24">
                        <Path Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                              Fill="{DynamicResource TextSecondary}"/>
                    </Canvas>
                </Viewbox>
                <!-- Loading spinner -->
                <Control Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Control.Style>
                        <Style TargetType="Control" BasedOn="{StaticResource ModernSpinnerStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Control.Style>
                </Control>
            </Grid>

            <!-- TextBox -->
            <TextBox x:Name="TxtSearch"
                     Grid.Column="1"
                     Text="{Binding SearchText, ElementName=root, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="{Binding FontSize, ElementName=root}"
                     
                     Foreground="{DynamicResource TextPrimary}"
                     Background="Transparent"
                     BorderThickness="0"
                     VerticalAlignment="Center"
                     CaretBrush="{DynamicResource TextPrimary}"/>

            <!-- Placeholder -->
            <TextBlock x:Name="TxtPlaceholder"
                       Grid.Column="1"
                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickSearch_Placeholder]}"
                       FontSize="{Binding FontSize, ElementName=root}"
                       
                       Foreground="{DynamicResource TextSecondary}"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Right Icon Grid (Visible only when IsIconOnLeft is False) -->
            <Grid Grid.Column="2" Margin="11,0,0,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsIconOnLeft, ElementName=root}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <!-- Magnifier icon -->
                <Viewbox Width="29" Height="29" Opacity="0.6">
                    <Viewbox.Style>
                        <Style TargetType="Viewbox">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Viewbox.Style>
                    <Canvas Width="24" Height="24">
                        <Path Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                              Fill="{DynamicResource TextSecondary}"/>
                    </Canvas>
                </Viewbox>
     
                <!-- Loading spinner -->
                <Control Width="27" Height="27">
                    <Control.Style>
                        <Style TargetType="Control" BasedOn="{StaticResource ModernSpinnerStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Control.Style>
                </Control>
            </Grid>
        </Grid>
</UserControl>
