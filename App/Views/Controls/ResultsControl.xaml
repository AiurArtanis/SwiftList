<UserControl x:Class="SwiftList.App.ResultsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:SwiftList.App.Views.Controls"
             xmlns:services="clr-namespace:SwiftList.App.Services"
             xmlns:helpers="clr-namespace:SwiftList.App.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/Styles/ListBox.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/SearchWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="ResultsPanel">
        <!-- Unified container for results (either list or grid) -->
        <Grid x:Name="GridSearchResultsContainer" Visibility="Visible">
            <!-- Search results view (List Mode) -->
            <Grid x:Name="GridSearchResults" Visibility="Visible">
                <ListBox x:Name="LstResults"
                          Background="Transparent"
                          BorderThickness="0"
                          Height="0"
                          Padding="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          Style="{StaticResource SleekListBoxStyle}"
                          ItemContainerStyle="{StaticResource ResultItemStyle}"
                          ItemTemplate="{StaticResource SearchResultTemplate}"
                          SelectionMode="Single"
                          IsEnabled="{Binding IsResultsListEnabled}"/>
            </Grid>

            <!-- Search results view (Grid Mode) -->
            <Grid x:Name="GridSearchResultsGrid" Visibility="Collapsed">
                <ListView x:Name="LstGridResults"
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ItemContainerStyle="{StaticResource SearchResultItemStyle}"
                          SelectionMode="Single"
                          IsEnabled="{Binding IsResultsListEnabled}"
                          GridViewColumnHeader.Click="GridViewColumnHeader_Click">
                    <ListView.View>
                        <GridView>
                            <!-- Name Column -->
                            <GridViewColumn Header="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_HeaderName]}" Width="320">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0" Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False" Margin="0,0,26,0">
                                                <TextBlock Text="{Binding Name}"
                                                           
                                                           FontSize="13"
                                                           Foreground="{DynamicResource TextPrimary2}"
                                                           VerticalAlignment="Center"
                                                           helpers:MarqueeBehavior.EnableMarquee="True"/>
                                            </ScrollViewer>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- Path Column -->
                            <GridViewColumn Header="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_HeaderPath]}" Width="260">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" VerticalAlignment="Center">
                                            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False" Margin="0,0,24,0">
                                                <TextBlock Text="{Binding ParentDir}"
                                                           
                                                           Foreground="{DynamicResource TextSecondary2}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           helpers:MarqueeBehavior.EnableMarquee="True"/>
                                            </ScrollViewer>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- Date Modified Column -->
                            <GridViewColumn Header="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_HeaderDateModified]}" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DateModifiedText}"
                                                   
                                                   Foreground="{DynamicResource TextSecondary2}"
                                                   FontSize="12"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>
        <!-- Actions View (Self-drawn menu) -->
        <Grid x:Name="GridActions" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Header -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="14,10,14,10" Background="{DynamicResource ActionsHeaderBg}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_ActionsTitle]}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlue}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtActionsTarget" Grid.Column="1" Text="" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_EscBack]}" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <!-- Actions List -->
            <ListBox x:Name="LstActions" Grid.Row="1"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Style="{StaticResource SleekListBoxStyle}"
                     ItemContainerStyle="{StaticResource ActionItemStyle}"
                     ItemTemplate="{StaticResource ActionMenuItemTemplate}"
                     SelectionMode="Single"/>
        </Grid>
    </Grid>
</UserControl>
