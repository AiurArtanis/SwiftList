<UserControl x:Class="SwiftList.App.ResultsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:controls="clr-namespace:SwiftList.App.Views.Controls"
             xmlns:services="clr-namespace:SwiftList.App.Services"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="600">

    <Grid x:Name="ResultsPanel">
        <!-- Search results view -->
        <Grid x:Name="GridSearchResults" Visibility="Visible">
            <ListBox x:Name="LstResults"
                     Background="Transparent"
                     BorderThickness="0"
                     Height="0"
                     Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     Style="{StaticResource SleekListBoxStyle}"
                     ItemContainerStyle="{StaticResource ResultItemStyle}"
                     ItemTemplate="{StaticResource SearchResultTemplate}"
                     ItemsSource="{Binding Results}"
                     SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                     SelectionMode="Single"
                     IsEnabled="{Binding IsResultsListEnabled}"/>
        </Grid>

        <!-- Actions View (Self-drawn menu) -->
        <Grid x:Name="GridActions" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="14,10,14,10" Background="{DynamicResource ActionsHeaderBg}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_ActionsTitle]}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlue}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtActionsTarget" Grid.Column="1" Text="" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_EscBack]}" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Actions List -->
            <ListBox x:Name="LstActions" Grid.Row="1"
                     Background="Transparent"
                     BorderThickness="0"
                     MaxHeight="420"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Style="{StaticResource SleekListBoxStyle}"
                     ItemContainerStyle="{StaticResource ActionItemStyle}"
                     ItemTemplate="{StaticResource ActionMenuItemTemplate}"
                     SelectionMode="Single"/>
        </Grid>
    </Grid>
</UserControl>
