<UserControl x:Class="SwiftList.App.Views.Controls.SearchSidebarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:SwiftList.App.Services">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/Styles/SearchWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,12,0,12">
                <!-- Dynamic Plugins Sections (Fully Plugin-ized Sidebar) -->
                <ItemsControl ItemsSource="{Binding DynamicSidebarGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Rectangle Height="1" Fill="{DynamicResource SeparatorBrush}" Margin="18,12,18,12">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <TextBlock Text="{Binding Header}" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondary}" Margin="20,4,20,6"
                                           />
                                <ListBox ItemsSource="{Binding Items}" BorderThickness="0" Background="Transparent"
                                         ItemContainerStyle="{StaticResource SidebarItemStyle}"
                                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                         PreviewMouseWheel="ListBox_PreviewMouseWheel"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel LastChildFill="True">
                                                <Grid DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0" Width="14" Height="14">
                                                    <TextBlock x:Name="TxtIcon" Text="{Binding IconString}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Path x:Name="PathIcon" Data="{Binding IconData}" Stretch="Uniform" Visibility="Collapsed"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                                </Grid>
                                                <TextBlock Text="{Binding DisplayName}"  FontSize="13"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap"/>
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasIconData}" Value="True">
                                                    <Setter TargetName="TxtIcon" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="PathIcon" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
