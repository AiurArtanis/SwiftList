<Window x:Class="SwiftList.App.QuickSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SwiftList.App"
        Title="SwiftList"
        Width="680" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">


    <!-- Main card container with drop shadow -->
    <Border Margin="24,40,24,24" CornerRadius="12" Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="4" Opacity="0.25" Color="{DynamicResource ShadowColor}"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Search bar -->
                <RowDefinition Height="Auto"/>
                <!-- Separator -->
                <RowDefinition Height="Auto"/>
                <!-- Results panel (grows with content) -->
                <RowDefinition Height="Auto"/>
                <!-- Status bar -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════════ 1. Search Bar ═══════════ -->
            <local:SearchBoxControl x:Name="SearchBox" Grid.Row="0"/>

            <!-- ═══════════ 2. Separator ═══════════ -->
            <Rectangle x:Name="ResultsSeparator"
                       Grid.Row="1"
                       Height="1"
                       Fill="{DynamicResource SeparatorBrush}"
                       Visibility="{Binding ResultsSeparatorVisibility}"/>

            <!-- ═══════════ 3. Results Panel ═══════════ -->
            <local:ResultsControl x:Name="ResultsPanelControl" Grid.Row="2" 
                                  Visibility="{Binding ResultsPanelVisibility}"/>

            <!-- ═══════════ 4. Status bar (shown when loading or ready) ═══════════ -->
            <local:StatusBarControl x:Name="StatusBarControl" Grid.Row="3" 
                                    Visibility="{Binding StatusBarVisibility}"/>
        </Grid>
    </Border>
</Window>
