<Window x:Class="SwiftList.App.QuickSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SwiftList.App"
        xmlns:services="clr-namespace:SwiftList.App.Services"
        Title="SwiftList"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Floating circle button style with hover & press states + premium shadow -->
        <Style x:Key="FloatingCircleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BadgeBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BadgeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                CornerRadius="14.5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.15" Color="{DynamicResource ShadowColor}"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Margin="24,40,24,24" CornerRadius="{Binding WindowCornerRadius}" Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                MouseLeftButtonDown="Border_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="4" Opacity="0.25" Color="{DynamicResource ShadowColor}"/>
            </Border.Effect>

            <Border CornerRadius="{Binding InnerCornerRadius}" ClipToBounds="True">
                <Grid Width="{Binding SearchBarWidth}">
            <Grid.RowDefinitions>
                <!-- Search bar -->
                <RowDefinition Height="Auto"/>
                <!-- Separator -->
                <RowDefinition Height="Auto"/>
                <!-- Startup panel tab strip (empty search box only) -->
                <RowDefinition Height="Auto"/>
                <!-- Results panel (grows with content) -->
                <RowDefinition Height="Auto"/>
                <!-- Status bar -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════════ 1. Search Bar ═══════════ -->
            <local:SearchBoxControl x:Name="SearchBox" Grid.Row="0" SearchText="{Binding SearchQuery, Mode=TwoWay}" Height="{Binding SearchBarHeight}" IsDynamicScalingEnabled="True" HorizontalAlignment="Stretch" IsServiceRunning="{Binding IsServiceConnected}"/>

            <!-- ═══════════ 2. Separator ═══════════ -->
            <Rectangle x:Name="ResultsSeparator"
                       Grid.Row="1"
                       Height="1"
                       Margin="12,0,12,0"
                       Fill="{DynamicResource SeparatorBrush}"
                       Visibility="{Binding ResultsSeparatorVisibility}"/>

            <!-- ═══════════ 3. Startup Panel Tab Strip ("初始面板") ═══════════ -->
            <ItemsControl x:Name="StartupPanelTabStrip" Grid.Row="2"
                          ItemsSource="{Binding StartupPanelTabs}"
                          Visibility="{Binding StartupPanelVisibility}"
                          Margin="12,8,12,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Styled like the Settings window's own tab headers (Button+underline pair,
                             see Resources/Styles/SettingsWindow.xaml's TabHeaderButtonStyle and
                             TabUnderlineStyle) for visual consistency; clicking the label switches to
                             this tab (IsSelected drives the accent-blue/underline "active" look). -->
                        <StackPanel Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding Label}" Command="{Binding SelectCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="FontSize" Value="14"/>
                                            <Setter Property="Padding" Value="0,0,0,10"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="&#xE711;" Command="{Binding CloseCommand}" Margin="8,0,0,8"
                                        ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[StartupPanel_CloseTabTooltip]}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Width" Value="16"/>
                                            <Setter Property="Height" Value="16"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                            <Setter Property="FontSize" Value="9"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary2}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" CornerRadius="3" Background="{TemplateBinding Background}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                            <Border Height="2" Background="{DynamicResource AccentBlue}" Margin="0,-2,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ═══════════ 4. Results Panel ═══════════ -->
            <local:ResultsControl x:Name="ResultsPanelControl" Grid.Row="3"
                                  ItemsSource="{Binding Results}"
                                  SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                                  ViewMode="List"
                                  Visibility="{Binding ResultsPanelVisibility}"/>

            <!-- ═══════════ 5. Status bar (shown when loading or ready) ═══════════ -->
            <local:StatusBarControl x:Name="StatusBarControl" Grid.Row="4"
                                    Visibility="{Binding StatusBarVisibility}"/>
        </Grid>
            </Border>
        </Border>

    <!-- Floating Open full search window button -->
    <Button x:Name="BtnOpenMore"
            Style="{StaticResource FloatingCircleButtonStyle}"
            Width="29"
            Height="29"
            Margin="0,32,16,0"
            Padding="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[QuickSearch_OpenMore]}">
        <Viewbox Width="16" Height="16" Opacity="0.85">
            <Canvas Width="24" Height="24">
                <Path Data="M7 7h10v10h-2V10.41l-8.29 8.3-1.42-1.42 8.3-8.29H7V7z"
                      Fill="{DynamicResource BadgeText}"/>
            </Canvas>
        </Viewbox>
    </Button>
</Grid>
</Window>
