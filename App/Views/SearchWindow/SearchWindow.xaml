<Window x:Class="SwiftList.App.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:SwiftList.App"
        xmlns:converters="clr-namespace:SwiftList.App.Converters"
        xmlns:controls="clr-namespace:SwiftList.App.Views.Controls"
        xmlns:services="clr-namespace:SwiftList.App.Services"
        xmlns:helpers="clr-namespace:SwiftList.App.Helpers"
        Title="{Binding WindowTitle}" Height="480" Width="854"
        MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/Styles/SearchWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <!-- Main border with shadow -->
    <Border x:Name="MainBorder" CornerRadius="{StaticResource CornerRadiusWindow}" Background="{DynamicResource ContentBg}"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" Margin="8"
            Effect="{StaticResource Elevation2}">
        <!-- ClipToBounds ignores CornerRadius (a WPF limitation, not a bug here): helpers:RoundedClip
             builds a real rounded-rect Clip instead: child content flush to the edge would otherwise show
             square corners poking past this Border's own rounded paint. -->
        <Border x:Name="ClippingBorder" CornerRadius="{StaticResource CornerRadiusWindow}" helpers:RoundedClip.IsEnabled="True">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Title Bar / Search Bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Main Content -->
                    <RowDefinition Height="*"/>
                    <!-- Status Bar -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- ═══════════ 1. Title Bar + Search ═══════════ -->
                <Border Grid.Row="0" Background="{DynamicResource HeaderBg}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                        CornerRadius="{StaticResource CornerRadiusWindowTop}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Search bar area -->
                        <Grid Grid.Column="0" Margin="12,12,8,12" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Drag Grip -->
                                <ColumnDefinition Width="*"/>    <!-- Input -->
                            </Grid.ColumnDefinitions>
                            <!-- Drag Grip Handle (::) -->
                            <Viewbox x:Name="DragGrip" Grid.Column="0" Width="10" Height="16" Margin="4,0,10,0" Opacity="0.4" Cursor="SizeAll" ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_DragTooltip]}">
                                <Canvas Width="12" Height="18" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                                    <Ellipse Canvas.Left="2" Canvas.Top="3" Width="2.5" Height="2.5" Fill="{DynamicResource TextSecondary}"/>
                                    <Ellipse Canvas.Left="7" Canvas.Top="3" Width="2.5" Height="2.5" Fill="{DynamicResource TextSecondary}"/>
                                    <Ellipse Canvas.Left="2" Canvas.Top="8" Width="2.5" Height="2.5" Fill="{DynamicResource TextSecondary}"/>
                                    <Ellipse Canvas.Left="7" Canvas.Top="8" Width="2.5" Height="2.5" Fill="{DynamicResource TextSecondary}"/>
                                    <Ellipse Canvas.Left="2" Canvas.Top="13" Width="2.5" Height="2.5" Fill="{DynamicResource TextSecondary}"/>
                                    <Ellipse Canvas.Left="7" Canvas.Top="13" Width="2.5" Height="2.5" Fill="{DynamicResource TextSecondary}"/>
                                </Canvas>
                            </Viewbox>
                            <!-- Shared SearchBoxControl component -->
                            <app:SearchBoxControl x:Name="SearchBox" Grid.Column="1" FontSize="15" Padding="0" IsIconOnLeft="True" SearchText="{Binding AdvancedQuery, Mode=TwoWay}" IsServiceRunning="{Binding IsServiceConnected}"/>
                        </Grid>
                        <!-- Window controls -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,6,0">
                            <Button Content="&#xE72B;" ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_BackTooltip]}" Style="{StaticResource WindowControlButton}" Click="BtnBackToQuickSearch_Click" Margin="0,0,8,0"/>
                            <Button Content="&#xE949;" Style="{StaticResource WindowControlButton}" Click="BtnMinimize_Click"/>
                            <Button x:Name="BtnMaximize" Content="&#xE922;" Style="{StaticResource WindowControlButton}" Click="BtnMaximize_Click"/>
                            <Button Content="&#xE8BB;" Style="{StaticResource CloseButton}" Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- ═══════════ 2. Main Content ═══════════ -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Sidebar -->
                        <ColumnDefinition Width="200" MinWidth="160" MaxWidth="280"/>
                        <!-- Content Area -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Sidebar -->
                    <controls:SearchSidebarControl Grid.Column="0"/>
                    <!-- Main Results Grid -->
                    <Grid Grid.Column="1" Background="{DynamicResource ContentBg}">
                        <!-- Shared ResultsControl component in Grid Mode -->
                        <app:ResultsControl x:Name="ResultsPanelControl"
                                            ItemsSource="{Binding FilteredResults}"
                                            ViewMode="Grid"
                                            Visibility="Visible"/>
                        <!-- No Results Hint -->
                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_NoResult]}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   Foreground="{DynamicResource TextSecondary2}"
                                   >
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowNoResultsHint}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Welcome View -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowWelcomeHint}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <!-- Search Icon -->
                            <TextBlock Text="&#xE11A;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="48"
                                       Foreground="{DynamicResource TextSecondary2}"
                                       HorizontalAlignment="Center"
                                       Opacity="0.5"
                                       Margin="0,0,0,16"/>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_WelcomeTitle]}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       HorizontalAlignment="Center"
                                       
                                       Margin="0,0,0,0"/>
                        </StackPanel>
                        <!-- Actions View (Self-drawn context actions menu, decoupled and shared) -->
                        <Grid x:Name="GridActions" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" 
                                    Height="{Binding SelectedItem.ActionsHeaderHeight, ElementName=ResultsPanelControl}" Padding="14,0,14,0" Background="{DynamicResource ActionsHeaderBg}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_ActionsTitle]}" Foreground="{DynamicResource AccentBlue}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtActionsTarget" Grid.Column="1" Text="" Foreground="{DynamicResource TextPrimary}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_EscBack]}" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <!-- Actions List -->
                            <ListBox x:Name="LstActions" Grid.Row="1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Style="{StaticResource SleekListBoxStyle}"
                                     ItemContainerStyle="{StaticResource ActionItemStyle}"
                                     ItemTemplate="{StaticResource ActionMenuItemTemplate}"
                                     SelectionMode="Single"/>
                        </Grid>
                    </Grid>
                </Grid>
                <!-- ═══════════ 3. Status Bar ═══════════ -->
                <Border Grid.Row="2" Background="{DynamicResource StatusBarBg}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                        CornerRadius="{StaticResource CornerRadiusWindowBottom}"
                        Padding="16,8,16,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilteredResults.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Result count with accent dot -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentColor}"
                                     Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtResultCount" Text="{Binding ResultCountText}"
                                       FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondary2}"
                                       
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- Keyboard hint -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_HintKeyboard]}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary2}"
                                   
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
