<Window x:Class="SwiftList.App.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:SwiftList.App"
        xmlns:converters="clr-namespace:SwiftList.App.Converters"
        xmlns:controls="clr-namespace:SwiftList.App.Views.Controls"
        xmlns:services="clr-namespace:SwiftList.App.Services"
        Title="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_Title]}" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Icon="pack://application:,,,/SwiftList.App;component/logo.png">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/Styles/SearchWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <!-- Main border with shadow -->
    <Border x:Name="MainBorder" CornerRadius="10" Background="{DynamicResource ContentBg}" 
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.2" Color="{DynamicResource ShadowColor}"/>
        </Border.Effect>
        <Border x:Name="ClippingBorder" CornerRadius="10" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Title Bar / Search Bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Main Content -->
                    <RowDefinition Height="*"/>
                    <!-- Status Bar -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- ═══════════ 1. Title Bar + Search ═══════════ -->
                <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" 
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Search bar area -->
                        <Grid Grid.Column="0" Margin="12,12,8,12" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Drag Grip -->
                                <ColumnDefinition Width="Auto"/> <!-- Search Icon -->
                                <ColumnDefinition Width="*"/>    <!-- Input -->
                            </Grid.ColumnDefinitions>
                            <!-- Drag Grip Handle (::) -->
                            <Viewbox x:Name="DragGrip" Grid.Column="0" Width="10" Height="16" Margin="4,0,10,0" Opacity="0.4" Cursor="SizeAll" ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_DragTooltip]}">
                                <Canvas Width="12" Height="18" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                                    <Ellipse Canvas.Left="2" Canvas.Top="3" Width="2.5" Height="2.5" Fill="{DynamicResource TextSecondary}"/>
                                    <Ellipse Canvas.Left="7" Canvas.Top="3" Width="2.5" Height="2.5" Fill="{DynamicResource TextSecondary}"/>
                                    <Ellipse Canvas.Left="2" Canvas.Top="8" Width="2.5" Height="2.5" Fill="{DynamicResource TextSecondary}"/>
                                    <Ellipse Canvas.Left="7" Canvas.Top="8" Width="2.5" Height="2.5" Fill="{DynamicResource TextSecondary}"/>
                                    <Ellipse Canvas.Left="2" Canvas.Top="13" Width="2.5" Height="2.5" Fill="{DynamicResource TextSecondary}"/>
                                    <Ellipse Canvas.Left="7" Canvas.Top="13" Width="2.5" Height="2.5" Fill="{DynamicResource TextSecondary}"/>
                                </Canvas>
                            </Viewbox>
                            <!-- Search Icon / Spinner loader -->
                            <Grid Grid.Column="1" Margin="0,0,12,0">
                                <!-- Magnifier icon -->
                                <Viewbox Width="20" Height="20" Opacity="0.5">
                                    <Viewbox.Style>
                                        <Style TargetType="Viewbox">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Viewbox.Style>
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                              Fill="{DynamicResource TextSecondary}"/>
                                    </Canvas>
                                </Viewbox>
                                <!-- Loading spinner -->
                                <Control Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Control.Style>
                                        <Style TargetType="Control" BasedOn="{StaticResource ModernSpinnerStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Control.Style>
                                </Control>
                            </Grid>
                            <!-- Search TextBox -->
                            <TextBox x:Name="TxtSearchBox"
                                     Grid.Column="2"
                                     BorderThickness="0"
                                     FontSize="15"
                                     FontFamily="Microsoft YaHei UI, Segoe UI"
                                     Foreground="{DynamicResource TextPrimary2}"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     CaretBrush="{DynamicResource AccentColor}"
                                     Text="{Binding AdvancedQuery, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsSearchBoxEnabled}"
                                     KeyDown="TxtSearchBox_KeyDown"/>
                            <TextBlock IsHitTestVisible="False"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_Placeholder]}"
                                       x:Name="TxtPlaceholder"
                                       Grid.Column="2"
                                       FontSize="15"
                                       FontFamily="Microsoft YaHei UI, Segoe UI"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtSearchBox}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <!-- Window controls -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,6,0">
                            <Button Content="&#xE72B;" ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_BackTooltip]}" Style="{StaticResource WindowControlButton}" Click="BtnBackToQuickSearch_Click" Margin="0,0,8,0"/>
                            <Button Content="&#xE949;" Style="{StaticResource WindowControlButton}" Click="BtnMinimize_Click"/>
                            <Button x:Name="BtnMaximize" Content="&#xE922;" Style="{StaticResource WindowControlButton}" Click="BtnMaximize_Click"/>
                            <Button Content="&#xE8BB;" Style="{StaticResource CloseButton}" Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- ═══════════ 2. Main Content ═══════════ -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Sidebar -->
                        <ColumnDefinition Width="200" MinWidth="160" MaxWidth="280"/>
                        <!-- Content Area -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Sidebar -->
                    <controls:SearchSidebarControl Grid.Column="0"/>
                    <!-- Main Results Grid -->
                    <Grid Grid.Column="1" Background="{DynamicResource ContentBg}">
                        <!-- Search results view -->
                        <Grid x:Name="GridSearchResults" Visibility="Visible">
                            <ListView x:Name="LstGridResults" BorderThickness="0" Background="Transparent"
                                      ItemsSource="{Binding FilteredResults}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ItemContainerStyle="{StaticResource SearchResultItemStyle}"
                                      MouseDoubleClick="LstGridResults_MouseDoubleClick"
                                      KeyDown="LstGridResults_KeyDown"
                                      PreviewMouseRightButtonUp="LstGridResults_PreviewMouseRightButtonUp"
                                      PreviewMouseWheel="LstGridResults_PreviewMouseWheel"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      IsEnabled="{Binding IsResultsListEnabled}"
                                      GridViewColumnHeader.Click="GridViewColumnHeader_Click">
                                <ListView.View>
                                    <GridView>
                                        <!-- Name Column -->
                                        <GridViewColumn Header="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_HeaderName]}" Width="320">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontFamily="Microsoft YaHei UI"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource TextPrimary2}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <!-- Path Column -->
                                        <GridViewColumn Header="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_HeaderPath]}" Width="260">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding FullPath}"
                                                               FontFamily="Microsoft YaHei UI"
                                                               Foreground="{DynamicResource TextSecondary2}"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontSize="12"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <!-- Date Modified Column -->
                                        <GridViewColumn Header="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_HeaderDateModified]}" Width="120">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DateModifiedText}"
                                                               FontFamily="Microsoft YaHei UI"
                                                               Foreground="{DynamicResource TextSecondary2}"
                                                               FontSize="12"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                        <!-- Actions View (Self-drawn context actions menu, decoupled and shared) -->
                        <Grid x:Name="GridActions" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Header -->
                            <Border Grid.Row="0" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="14,10,14,10" Background="{DynamicResource ActionsHeaderBg}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_ActionsTitle]}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlue}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtActionsTarget" Grid.Column="1" Text="" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_EscBack]}" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <!-- Actions List -->
                            <ListBox x:Name="LstActions" Grid.Row="1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Style="{StaticResource SleekListBoxStyle}"
                                     ItemContainerStyle="{StaticResource ActionItemStyle}"
                                     ItemTemplate="{StaticResource ActionMenuItemTemplate}"
                                     SelectionMode="Single"/>
                        </Grid>
                    </Grid>
                </Grid>
                <!-- ═══════════ 3. Status Bar ═══════════ -->
                <Border Grid.Row="2" Background="{DynamicResource StatusBarBg}" 
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                        Padding="16,8,16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Result count with accent dot -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentColor}" 
                                     Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtResultCount" Text="{Binding ResultCountText}" 
                                       FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondary2}" 
                                       FontFamily="Microsoft YaHei UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- Keyboard hint -->
                        <TextBlock Grid.Column="2" 
                                   Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Search_HintKeyboard]}"
                                   FontSize="11" 
                                   Foreground="{DynamicResource TextSecondary2}"
                                   FontFamily="Microsoft YaHei UI"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
