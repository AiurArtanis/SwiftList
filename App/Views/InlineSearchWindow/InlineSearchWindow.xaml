<Window x:Class="SwiftList.App.InlineSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SwiftList.App"
        xmlns:services="clr-namespace:SwiftList.App.Services"
        Title="SwiftList Inline"
        Width="437" Height="550" SizeToContent="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Focusable="True"
        ShowActivated="False">
    <!-- Outer Grid to support bottom/top alignment of the visible panel inside the transparent window -->
    <Grid x:Name="RootGrid" VerticalAlignment="Bottom">
        <!-- Main card - inverted layout: results on top, search box at bottom -->
        <Border x:Name="MainBorder" Margin="12" CornerRadius="8"
                Background="{DynamicResource ContentBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                ClipToBounds="True"
                VerticalAlignment="Bottom">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.22" Color="{DynamicResource ShadowColor}"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Results list & preview container (grows upward) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Separator -->
                    <RowDefinition Height="Auto"/>
                    <!-- Search box (anchored at bottom) -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- ═══════════ 1. Results Container (Wraps path banner and results list) ═══════════ -->
                <Grid x:Name="ResultsContainerWrapper" Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Top Path Preview Banner -->
                    <Border x:Name="PathPreviewBorder" Grid.Row="0" Background="{DynamicResource ActionsHeaderBg}" 
                            BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" 
                            Padding="14,8,14,8"
                            Visibility="Collapsed">
                        <TextBlock x:Name="PathPreviewTextBlock" 
                                   Foreground="{DynamicResource TextSecondary2}" 
                                   FontSize="12" 
                                   TextWrapping="Wrap"
                                   LineHeight="16"/>
                    </Border>

                    <local:ResultsControl x:Name="ResultsPanelControl" Grid.Row="1"
                                          ItemsSource="{Binding Results}"
                                          SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                                          ViewMode="List"
                                          Visibility="{Binding ResultsPanelVisibility}"/>
                </Grid>
                <!-- ═══════════ 2. Separator ═══════════ -->
                <Rectangle x:Name="ResultsSeparator" Grid.Row="1" Height="1" Fill="{DynamicResource SeparatorBrush}"
                           Margin="12,0,12,0"
                           Visibility="{Binding ResultsSeparatorVisibility}"/>
                <!-- ═══════════ 3. Search Box (Bottom Anchored) ═══════════ -->
                <Border x:Name="SearchBoxBorder" Grid.Row="2" Background="{DynamicResource HeaderBg}" 
                        CornerRadius="0,0,7,7"
                        Padding="12,8,12,8">
                    <!-- Shared SearchBoxControl -->
                    <local:SearchBoxControl x:Name="SearchBox" FontSize="14" Padding="0" IsIconOnLeft="False" 
                                            SearchText="{Binding SearchQuery, Mode=TwoWay}"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
