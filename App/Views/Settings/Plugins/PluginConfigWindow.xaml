<Window x:Class="SwiftList.App.Views.Settings.Plugins.PluginConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="clr-namespace:SwiftList.App.Services"
        xmlns:vm="clr-namespace:SwiftList.App.ViewModels.Settings.Plugins"
        xmlns:ctrl="clr-namespace:SwiftList.App.Views.Controls"
        mc:Ignorable="d"
        MinWidth="480" MinHeight="220" MaxWidth="900" MaxHeight="800"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded">

    <Window.Title>
        <MultiBinding StringFormat="{}{0} - {1}">
            <Binding Path="Name"/>
            <Binding Source="{x:Static services:TranslationManager.Instance}" Path="[Plugins_Config_TitleSuffix]"/>
        </MultiBinding>
    </Window.Title>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SwiftList.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis" xmlns:conv="clr-namespace:SwiftList.App.Views.Converters"/>
            <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True" xmlns:conv="clr-namespace:SwiftList.App.Views.Converters"/>
            <conv:StringToVisibilityConverter x:Key="StringToVis" xmlns:conv="clr-namespace:SwiftList.App.Views.Converters"/>
            <conv:NullToVisibilityConverter x:Key="NullToVis" xmlns:conv="clr-namespace:SwiftList.App.Views.Converters"/>
            <conv:EmptyStringToPlaceholderConverter x:Key="EmptyOrPlaceholder" xmlns:conv="clr-namespace:SwiftList.App.Views.Converters"/>
            <conv:ReferenceEqualsConverter x:Key="RefEquals" xmlns:conv="clr-namespace:SwiftList.App.Views.Converters"/>
            <conv:BadgeFieldToVisibilityConverter x:Key="BadgeFieldToVis" xmlns:conv="clr-namespace:SwiftList.App.Views.Converters"/>

            <!-- Selectable row container for the array master list -->
            <Style x:Key="ArrayMasterListItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,2"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,6">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Implicit TextBox styling matching settings theme -->
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="ContextMenu"><Setter.Value><ContextMenu Style="{DynamicResource {x:Type ContextMenu}}"><MenuItem Command="ApplicationCommands.Cut"/><MenuItem Command="ApplicationCommands.Copy"/><MenuItem Command="ApplicationCommands.Paste"/></ContextMenu></Setter.Value></Setter>
            </Style>


            <DataTemplate x:Key="HotkeyFieldTemplate">
                <ctrl:HotkeyRecorderControl Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            RequireModifier="{Binding HotkeyRequireModifier}"
                                            Width="180" Height="26"/>
            </DataTemplate>

            <DataTemplate x:Key="FilePathFieldTemplate">
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="150" Height="26"/>
                    <Button Content="..." Style="{StaticResource SettingsButton}" MinWidth="0" Padding="4,0" Width="28" Height="26" Margin="4,0,0,0" Tag="File" Click="BrowsePath_Click"/>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="FolderPathFieldTemplate">
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="150" Height="26"/>
                    <Button Content="..." Style="{StaticResource SettingsButton}" MinWidth="0" Padding="4,0" Width="28" Height="26" Margin="4,0,0,0" Tag="Folder" Click="BrowsePath_Click"/>
                </StackPanel>
            </DataTemplate>

            <!-- Implicit ComboBox styling to match SettingsComboBox -->
            <Style TargetType="ComboBox" BasedOn="{StaticResource SettingsComboBox}">
                <Setter Property="Height" Value="26"/>
            </Style>

            <!-- Renders just the value editor for a field (no label/description), shared by the
                 standalone field row below and by each cell of an array table. -->
            <Style x:Key="FieldValueEditorStyle" TargetType="ContentControl">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!-- Boolean fields -->
                    <DataTrigger Binding="{Binding IsBoolean}" Value="True">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Value, Mode=TwoWay}" Margin="0"/>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>

                    <!-- Text fields -->
                    <DataTrigger Binding="{Binding IsText}" Value="True">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="180" Height="26"/>
                                        <!-- Spacer for non-icon fields to align them with the icon field preview -->
                                        <Border Width="24" Height="24" Margin="8,0,0,0" CornerRadius="4"
                                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                                Visibility="{Binding IsIconField, Converter={StaticResource InvertBoolToVis}}"
                                                VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <!-- Preview Icon if it's the Icon field -->
                                        <Border Width="24" Height="24" Margin="8,0,0,0" CornerRadius="4"
                                                Background="{DynamicResource ControlBackground}"
                                                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                                Visibility="{Binding IsIconField, Converter={StaticResource BoolToVis}}"
                                                VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Path Data="{Binding Value}" Fill="{DynamicResource DefaultPluginIconColor}"
                                                  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>

                    <!-- StringList fields -->
                    <DataTrigger Binding="{Binding IsStringList}" Value="True">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                             Width="260" Height="80" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Top" Padding="6,4" FontFamily="Cascadia Mono, Consolas"/>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>

                    <!-- Integer fields -->
                    <DataTrigger Binding="{Binding IsInteger}" Value="True">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="80" Height="26"/>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>

                    <!-- Hotkey fields -->
                    <DataTrigger Binding="{Binding IsHotkey}" Value="True">
                        <Setter Property="ContentTemplate" Value="{StaticResource HotkeyFieldTemplate}"/>
                    </DataTrigger>

                    <!-- FilePath fields -->
                    <DataTrigger Binding="{Binding IsFilePath}" Value="True">
                        <Setter Property="ContentTemplate" Value="{StaticResource FilePathFieldTemplate}"/>
                    </DataTrigger>

                    <!-- FolderPath fields -->
                    <DataTrigger Binding="{Binding IsFolderPath}" Value="True">
                        <Setter Property="ContentTemplate" Value="{StaticResource FolderPathFieldTemplate}"/>
                    </DataTrigger>

                    <!-- Choice fields -->
                    <DataTrigger Binding="{Binding IsChoice}" Value="True">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value, Mode=TwoWay}" MinWidth="180"/>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Compact array-row delete button, reused by both the object-array table and the
                 scalar-array list so their rows line up the same way. -->
            <Style x:Key="ArrayRowDeleteButton" TargetType="Button">
                <Setter Property="Content" Value="&#xE74D;"/>
                <Setter Property="Command" Value="{Binding DeleteCommand}"/>
                <Setter Property="Width" Value="28"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Margin" Value="8,0,0,0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary2}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Label-above-editor row for an array item's detail panel. The window is wide enough
                 now (resizable) that the shared label-left/editor-right row below would leave an
                 awkward gap between them; stacking keeps each field readable at any window width. -->
            <DataTemplate x:Key="ArrayDetailStackedFieldTemplate">
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap" Margin="0,0,0,4" Visibility="{Binding Label, Converter={StaticResource StringToVis}}"/>
                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                               Margin="0,0,0,6" Visibility="{Binding Description, Converter={StaticResource StringToVis}}"/>
                    <ContentControl Content="{Binding}" HorizontalAlignment="Left" Focusable="False" Style="{StaticResource FieldValueEditorStyle}"/>
                </StackPanel>
            </DataTemplate>

            <!-- Boolean fields read better as a compact label-left/checkbox-right row, matching a
                 normal settings toggle, instead of the stacked layout used for every other field type. -->
            <DataTemplate x:Key="ArrayDetailBooleanFieldTemplate">
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                   TextWrapping="Wrap" MaxWidth="320" HorizontalAlignment="Left" Visibility="{Binding Label, Converter={StaticResource StringToVis}}"/>
                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                   MaxWidth="320" HorizontalAlignment="Left" Margin="0,2,0,0" Visibility="{Binding Description, Converter={StaticResource StringToVis}}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Value, Mode=TwoWay}" VerticalAlignment="Center"/>
                </Grid>
            </DataTemplate>

            <!-- Picks the stacked layout for most field types, but the compact row for Boolean fields. -->
            <DataTemplate x:Key="ArrayDetailFieldTemplate">
                <ContentControl Content="{Binding}" Focusable="False">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource ArrayDetailStackedFieldTemplate}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBoolean}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource ArrayDetailBooleanFieldTemplate}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </DataTemplate>

            <!-- Implicit DataTemplate for recursive/nested plugin config fields rendering -->
            <DataTemplate DataType="{x:Type vm:PluginConfigFieldViewModel}">
                <Border Style="{StaticResource SettingsRow}" Padding="8,6" Margin="0,0,0,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <!-- Label and its editor stay glued together as one left-anchored unit;
                                 the trailing * column just absorbs whatever's left of a wide window,
                                 instead of stretching the gap between the label and its own control.
                                 SharedSizeGroup syncs this column to the widest label on screen, so
                                 every row's editor/checkbox lines up at the same X (see the page-level
                                 IsSharedSizeScope="True" this relies on). -->
                            <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Label & Description for simple inputs -->
                        <StackPanel Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,12,0"
                                    Visibility="{Binding IsSimpleField, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" MaxWidth="320" HorizontalAlignment="Left" Visibility="{Binding Label, Converter={StaticResource StringToVis}}"/>
                            <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxWidth="320" HorizontalAlignment="Left" Margin="0,2,0,0" Visibility="{Binding Description, Converter={StaticResource StringToVis}}"/>
                        </StackPanel>

                        <!-- Field Controls for simple inputs -->
                        <ContentControl Content="{Binding}" Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" Focusable="False"
                                        Style="{StaticResource FieldValueEditorStyle}"/>

                        <!-- Object layout -->
                        <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Margin="4,4,4,4"
                                    Visibility="{Binding IsObject, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left" Margin="0,0,0,6" Visibility="{Binding Description, Converter={StaticResource StringToVis}}"/>
                            
                            <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1,0,0,0" Margin="8,0,0,0" Padding="12,0,0,0">
                                <ItemsControl ItemsSource="{Binding Children}"/>
                            </Border>
                        </StackPanel>

                        <!-- Group layout -->
                        <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Margin="4,4,4,4"
                                    Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left" Margin="0,0,0,6" Visibility="{Binding Description, Converter={StaticResource StringToVis}}"/>
                            
                            <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1,0,0,0" Margin="8,0,0,0" Padding="12,0,0,0">
                                <ItemsControl ItemsSource="{Binding Children}"/>
                            </Border>
                        </StackPanel>

                        <!-- Array layout: shared heading, then either the object-array table or the
                             scalar-array list below it. -->
                        <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Margin="4,4,4,4"
                                    Visibility="{Binding IsArray, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left" Margin="0,0,0,6" Visibility="{Binding Description, Converter={StaticResource StringToVis}}"/>

                            <!-- Object-array master/detail: a compact selectable list on the left,
                                 the selected item's full editable fields on the right -->
                            <Grid Margin="8,0,0,0" Visibility="{Binding IsObjectArray, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*" MinWidth="260"/>
                                </Grid.ColumnDefinitions>

                                <!-- Master list: height locked to the detail panel's natural height (kept
                                     in sync from code-behind, see ArrayDetailPanel_Loaded) so only the
                                     ListBox itself scrolls; the Add button stays pinned directly beneath it. -->
                                <Grid x:Name="ArrayMasterListGrid" Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <ListBox Grid.Row="0" ItemsSource="{Binding ArrayItems}" SelectedItem="{Binding SelectedArrayItem, Mode=TwoWay}"
                                             BorderThickness="0" Background="Transparent"
                                             ItemContainerStyle="{StaticResource ArrayMasterListItemStyle}"
                                             SelectionChanged="ArrayMasterList_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="22" Height="22" Margin="0,0,8,0" CornerRadius="4"
                                                            Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                                            Visibility="{Binding IconField, Converter={StaticResource NullToVis}}">
                                                        <Path Data="{Binding IconField.Value}" Fill="{DynamicResource DefaultPluginIconColor}" Width="11" Height="11" Stretch="Uniform"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TitleField.Value, Converter={StaticResource EmptyOrPlaceholder}}" FontSize="12" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                        <Border Background="{DynamicResource BadgeBackground}" BorderBrush="{DynamicResource BadgeBorderBrush}" BorderThickness="1"
                                                                CornerRadius="4" Padding="5,0,5,1" Margin="0,3,0,0" HorizontalAlignment="Left"
                                                                Visibility="{Binding BadgeField, Converter={StaticResource BadgeFieldToVis}}">
                                                            <TextBlock Text="{Binding BadgeField.Value}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BadgeText}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Style="{StaticResource ArrayRowDeleteButton}" VerticalAlignment="Center"
                                                            ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Delete]}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Grid.Row="1" Command="{Binding AddCommand}" Style="{StaticResource SettingsButton}" Height="26" Padding="8,0"
                                            Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Add]}"
                                            FontSize="11" Cursor="Hand" HorizontalContentAlignment="Center" Margin="0,6,0,0"/>
                                </Grid>

                                <!-- Detail panel for the selected item. VerticalAlignment="Top" keeps its
                                     ActualHeight equal to its own natural content size regardless of the
                                     row's resolved height, which ArrayDetailPanel_Loaded (code-behind)
                                     then mirrors onto ArrayMasterListGrid: a pure Grid-Auto-row approach
                                     here creates a feedback loop where a tall item list on the left drags
                                     this panel's height up with it instead of staying at its own size. -->
                                <Border x:Name="ArrayDetailPanel" Grid.Column="2" VerticalAlignment="Top" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1,0,0,0" Padding="12,0,0,0"
                                        Visibility="{Binding SelectedArrayItem, Converter={StaticResource NullToVis}}"
                                        Loaded="ArrayDetailPanel_Loaded" SizeChanged="ArrayDetailPanel_SizeChanged">
                                    <StackPanel DataContext="{Binding SelectedArrayItem}">
                                        <ItemsControl ItemsSource="{Binding Children}" ItemTemplate="{StaticResource ArrayDetailFieldTemplate}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Scalar-array list: a single value column, no header needed -->
                            <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1,0,0,0" Margin="8,0,0,0" Padding="12,0,0,0"
                                    Visibility="{Binding IsScalarArray, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding ArrayItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="0,4" Margin="0,0,0,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ContentControl Content="{Binding SimpleValueViewModel}" VerticalAlignment="Center" Focusable="False"
                                                                         Style="{StaticResource FieldValueEditorStyle}"/>
                                                        <Button Style="{StaticResource ArrayRowDeleteButton}"
                                                                ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Delete]}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Command="{Binding AddCommand}" Style="{StaticResource PrimarySettingsButton}" Height="24" MinWidth="80" Padding="8,0" Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Add]}" FontSize="11" Cursor="Hand" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
 
    <Border CornerRadius="10" Background="{DynamicResource ContentBg}"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.2" Color="{DynamicResource ShadowColor}"/>
        </Border.Effect>
        <Border CornerRadius="10" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <!-- Auto here (not *) so SizeToContent can compute a real, finite height on first
                         open; a Star row measured against SizeToContent's infinite available space is
                         a well-known WPF degenerate case that makes the whole window balloon out to
                         nearly the full screen. Window_Loaded switches this to Star once SizeToContent
                         has already settled, so a later manual resize still fills the extra space. -->
                    <RowDefinition x:Name="ContentRow" Height="Auto"/>
                    <RowDefinition Height="52"/>
                </Grid.RowDefinitions>
 
                <!-- Titlebar -->
                <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                        CornerRadius="9,9,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextPrimary2}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary2}" VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} - {1}">
                                        <Binding Path="Name"/>
                                        <Binding Source="{x:Static services:TranslationManager.Instance}" Path="[Plugins_Config_TitleSuffix]"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                        <Button Content="&#xE8BB;" Style="{StaticResource CloseButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Click="BtnClose_Click"/>
                    </Grid>
                </Border>
 
                <!-- Config content scroll list -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel" Padding="16,12">
                    <!-- IsSharedSizeScope lets every field row's label column (SharedSizeGroup="FieldLabel"
                         below) sync to the widest label currently on screen, so their editors/checkboxes
                         all start at the same X instead of each row sizing its own label independently. -->
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <!-- Any fields outside a Group render directly, same as always -->
                        <ItemsControl ItemsSource="{Binding NonGroupConfigFields}"/>

                        <!-- 2+ top-level Groups: render as tabs (like the Hotkeys page) instead of
                             stacking every group's contents down the page -->
                        <StackPanel Visibility="{Binding HasMultipleConfigGroups, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <ItemsControl ItemsSource="{Binding ConfigGroups}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,28,0">
                                                <Button Content="{Binding Label}"
                                                        Command="{Binding DataContext.SelectConfigGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource TabHeaderButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{StaticResource RefEquals}">
                                                                            <Binding/>
                                                                            <Binding Path="DataContext.SelectedConfigGroup" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource TabUnderlineStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{StaticResource RefEquals}">
                                                                            <Binding/>
                                                                            <Binding Path="DataContext.SelectedConfigGroup" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Border Height="1" Background="{DynamicResource SettingsRowBorderBrush}" Margin="0,0,0,15"/>

                            <ItemsControl ItemsSource="{Binding SelectedConfigGroup.Children}"/>
                        </StackPanel>

                        <!-- 0 or 1 Groups: not worth a tab bar, fall back to the flat rendering used
                             everywhere else (a lone Group still renders its own bold title inline) -->
                        <ItemsControl ItemsSource="{Binding ConfigGroups}" Visibility="{Binding HasMultipleConfigGroups, Converter={StaticResource InvertBoolToVis}}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" Background="{DynamicResource StatusBarBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,9,9">
                    <Grid Margin="16,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimarySettingsButton}"
                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_OK]}"
                                    Click="BtnOk_Click" MinWidth="80"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
