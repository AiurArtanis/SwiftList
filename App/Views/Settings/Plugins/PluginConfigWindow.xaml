<Window x:Class="SwiftList.App.Views.Settings.Plugins.PluginConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="clr-namespace:SwiftList.App.Services"
        xmlns:helpers="clr-namespace:SwiftList.App.Helpers"
        mc:Ignorable="d"
        MinWidth="480" MinHeight="220" MaxWidth="900" MaxHeight="800"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded">

    <Window.Title>
        <MultiBinding StringFormat="{}{0} - {1}">
            <Binding Path="Name"/>
            <Binding Source="{x:Static services:TranslationManager.Instance}" Path="[Plugins_Config_TitleSuffix]"/>
        </MultiBinding>
    </Window.Title>

    <Window.Resources>
        <ResourceDictionary Source="FieldRowTemplate.xaml"/>
    </Window.Resources>

    <Border CornerRadius="10" Background="{DynamicResource ContentBg}"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.2" Color="{DynamicResource ShadowColor}"/>
        </Border.Effect>
        <!-- ClipToBounds ignores CornerRadius (a WPF limitation, not a bug here): helpers:RoundedClip
             builds a real rounded-rect Clip instead: child content flush to the edge would otherwise show
             square corners poking past this Border's own rounded paint. -->
        <Border CornerRadius="10" helpers:RoundedClip.IsEnabled="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <!-- Auto here (not *) so SizeToContent can compute a real, finite height on first
                         open; a Star row measured against SizeToContent's infinite available space is
                         a well-known WPF degenerate case that makes the whole window balloon out to
                         nearly the full screen. Window_Loaded switches this to Star once SizeToContent
                         has already settled, so a later manual resize still fills the extra space. -->
                    <RowDefinition x:Name="ContentRow" Height="Auto"/>
                    <RowDefinition Height="52"/>
                </Grid.RowDefinitions>
 
                <!-- Titlebar -->
                <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                        CornerRadius="9,9,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextPrimary2}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary2}" VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} - {1}">
                                        <Binding Path="Name"/>
                                        <Binding Source="{x:Static services:TranslationManager.Instance}" Path="[Plugins_Config_TitleSuffix]"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                        <Button Content="&#xE8BB;" Style="{StaticResource CloseButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Click="BtnClose_Click"/>
                    </Grid>
                </Border>
 
                <!-- Config content scroll list -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel" Padding="16,12">
                    <!-- IsSharedSizeScope lets every field row's label column (SharedSizeGroup="FieldLabel"
                         below) sync to the widest label currently on screen, so their editors/checkboxes
                         all start at the same X instead of each row sizing its own label independently. -->
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <!-- Any fields outside a Group render directly, same as always -->
                        <ItemsControl ItemsSource="{Binding NonGroupConfigFields}"/>

                        <!-- 2+ top-level Groups: render as tabs (like the Hotkeys page) instead of
                             stacking every group's contents down the page -->
                        <StackPanel Visibility="{Binding HasMultipleConfigGroups, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <ItemsControl ItemsSource="{Binding ConfigGroups}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,28,0">
                                                <Button Content="{Binding Label}"
                                                        Command="{Binding DataContext.SelectConfigGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource TabHeaderButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{StaticResource RefEquals}">
                                                                            <Binding/>
                                                                            <Binding Path="DataContext.SelectedConfigGroup" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource TabUnderlineStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{StaticResource RefEquals}">
                                                                            <Binding/>
                                                                            <Binding Path="DataContext.SelectedConfigGroup" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Border Height="1" Background="{DynamicResource SettingsRowBorderBrush}" Margin="0,0,0,15"/>

                            <ItemsControl ItemsSource="{Binding SelectedConfigGroup.Children}"/>
                        </StackPanel>

                        <!-- 0 or 1 Groups: not worth a tab bar, fall back to the flat rendering used
                             everywhere else (a lone Group still renders its own bold title inline) -->
                        <ItemsControl ItemsSource="{Binding ConfigGroups}" Visibility="{Binding HasMultipleConfigGroups, Converter={StaticResource InvertBoolToVis}}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" Background="{DynamicResource StatusBarBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,9,9">
                    <Grid Margin="16,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimarySettingsButton}"
                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_OK]}"
                                    Click="BtnOk_Click" MinWidth="80"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
