<UserControl x:Class="SwiftList.App.Views.Settings.Plugins.PluginManagementSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:SwiftList.App.Services"
             xmlns:conv="clr-namespace:SwiftList.App.Views.Converters"
             xmlns:vm="clr-namespace:SwiftList.App.ViewModels.Settings.Plugins"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SwiftList.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../../Resources/Styles/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True"/>
            <conv:ComponentTypeToLabelConverter x:Key="TypeToLabel"/>
            <conv:ComponentTypeToBadgeBrushConverter x:Key="TypeToBrush"/>
            <conv:StringToVisibilityConverter x:Key="StringToVis"/>

            <!-- Plain-text "select all / deselect all" toggle: a real Button (chrome, border,
                 background) reads as a heavier action than it is next to a group label, so this
                 uses a hyperlink look instead to match its actual weight. -->
            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <TextBlock x:Name="LinkText" Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="LinkText" Property="TextDecorations" Value="Underline"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- Page header -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource SettingsSectionTitle}"
                               Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_Title]}"
                               VerticalAlignment="Center"/>
                    <Border CornerRadius="4" Background="{DynamicResource BadgeBackground}" BorderBrush="{DynamicResource BadgeBorderBrush}" BorderThickness="1" Margin="8,0,0,0" Padding="5,1,5,2" VerticalAlignment="Center"
                            Cursor="Hand" MouseLeftButtonUp="SdkBadge_MouseLeftButtonUp"
                            ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_DevGuideTooltip]}">
                        <TextBlock Text="{Binding HostSdkVersion, StringFormat='SDK v{0}'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BadgeText}" />
                    </Border>
                </StackPanel>

                <!-- Expand/collapse-all for every plugin card on this page -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding ExpandAllToggleLabel}" Command="{Binding ToggleExpandAllCommand}"
                            Style="{StaticResource LinkButton}" FontSize="12"
                            Visibility="{Binding IsEmpty, Converter={StaticResource InvertBoolToVis}}"/>
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource SettingsHintText}"
                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_Hint]}"/>

            <!-- Empty state -->
            <Border Style="{StaticResource SettingsCard}"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_NoPlugins]}"
                           Foreground="{DynamicResource TextSecondary2}"
                           HorizontalAlignment="Center" Padding="0,8"/>
            </Border>

            <!-- Plugin cards -->
            <ItemsControl x:Name="PluginsList" ItemsSource="{Binding Plugins}" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,12">
                            <StackPanel>

                                <!-- Plugin header row -->
                                <Grid Cursor="Hand">
                                    <Grid.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.ToggleExpandCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Grid.InputBindings>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Plugin icon (fallback glyph shown when a plugin has no icon of its
                                         own). BadgeBackground/BadgeText is a neutral gray meant for small
                                         text pills (see the SDK version badge above); reusing it as a
                                         36x36 tile fill made the icon read as flat/washed-out next to this
                                         page's still-colorful checkboxes and buttons, so the tile itself
                                         stays neutral (HoverBackground) while the glyph keeps the accent
                                         color, matching the common "neutral tile, colored icon" pattern. -->
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                            Background="{DynamicResource HoverBackground}" Margin="0,0,12,0">
                                        <TextBlock Text="&#xECAA;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16" Foreground="{DynamicResource AccentBlue}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Name + meta -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   
                                                   FontSize="14" FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TextPrimary}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_Version]}"
                                                       Foreground="{DynamicResource TextSecondary2}" FontSize="11"/>
                                            <TextBlock Text=" " FontSize="11"/>
                                            <TextBlock Text="{Binding Version}"
                                                       Foreground="{DynamicResource TextPrimary2}" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Text="  ·  " Foreground="{DynamicResource SeparatorBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding DllFileName}"
                                                       Foreground="{DynamicResource TextSecondary2}" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Configure Button -->
                                    <Button Grid.Column="2" 
                                            Command="{Binding DataContext.ConfigurePluginCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding HasConfigFields, Converter={StaticResource BoolToVis}}"
                                            Style="{StaticResource SettingsButton}"
                                            ContentTemplate="{x:Null}"
                                            Margin="4,0" Padding="8,4" VerticalAlignment="Center" Focusable="False">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Common_Configure]}"  FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Expand/collapse chevron -->
                                    <TextBlock Grid.Column="3" FontFamily="Segoe MDL2 Assets"
                                               FontSize="10" Foreground="{DynamicResource TextSecondary2}"
                                               VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE70E;"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                        <Setter Property="Text" Value="&#xE70D;"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Components section (collapsible) -->
                                <StackPanel Margin="0,12,0,0"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">

                                    <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_ComponentsTitle]}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondary2}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="{Binding SelectAllToggleLabel}" Command="{Binding ToggleAllComponentsCommand}"
                                                Style="{StaticResource LinkButton}" FontSize="11"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Visibility="{Binding HasToggleableComponents, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>

                                    <!-- No components placeholder -->
                                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_NoComponents]}"
                                               Foreground="{DynamicResource TextSecondary2}" FontSize="12"
                                               Visibility="{Binding HasNoComponents, Converter={StaticResource BoolToVis}}"/>

                                    <!-- Component Groups -->
                                    <ItemsControl ItemsSource="{Binding ComponentGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,14">
                                                    <!-- Group Header -->
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                            <Border Width="3" Height="12" CornerRadius="1"
                                                                    Background="{Binding ComponentType, Converter={StaticResource TypeToBrush}}"
                                                                    Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding GroupName}"
                                                                       FontSize="11" FontWeight="Bold"
                                                                       Foreground="{Binding ComponentType, Converter={StaticResource TypeToBrush}}"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="{Binding SelectAllToggleLabel}" Command="{Binding ToggleAllCommand}"
                                                                Style="{StaticResource LinkButton}" FontSize="11"
                                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                Visibility="{Binding HasToggleableComponents, Converter={StaticResource BoolToVis}}"/>
                                                    </Grid>

                                                    <!-- Nested components -->
                                                    <ItemsControl ItemsSource="{Binding Components}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource SettingsRow}" Padding="8,6" Margin="0,0,0,4">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="28"/>
                                                                            <ColumnDefinition Width="28"/>
                                                                        </Grid.ColumnDefinitions>

                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="{Binding DisplayName}"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                                   VerticalAlignment="Center"/>

                                                                        <!-- Info button (!) -->
                                                                        <Border Grid.Column="1" Width="14" Height="14" CornerRadius="7" 
                                                                                Background="{DynamicResource HoverBackground}" 
                                                                                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                                                                                HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Help">
                                                                            <Border.ToolTip>
                                                                                <ToolTip MaxWidth="300">
                                                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                                                                </ToolTip>
                                                                            </Border.ToolTip>
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Description}" Value="">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <TextBlock Text="!" FontSize="9" FontWeight="Bold" 
                                                                                       Foreground="{DynamicResource TextSecondary2}" 
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                                        </Border>

                                                                        <!-- CheckBox shown for toggleable components -->
                                                                        <CheckBox Grid.Column="2"
                                                                                  IsChecked="{Binding IsEnabled}"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  Visibility="{Binding IsToggleable, Converter={StaticResource BoolToVis}}"/>

                                                                        <!-- Lock icon shown for read-only components (e.g. TranslationProvider) -->
                                                                        <TextBlock Grid.Column="2"
                                                                                   Text="&#xE72E;"
                                                                                   FontFamily="Segoe MDL2 Assets"
                                                                                   FontSize="13"
                                                                                   Foreground="{DynamicResource SeparatorBrush}"
                                                                                   ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_ReadOnlyTooltip]}"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Visibility="{Binding IsToggleable, Converter={StaticResource InvertBoolToVis}}"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                 </StackPanel>

                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                 </StackPanel>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Restart note banner -->
            <Border Margin="0,4,0,8" Padding="12,8" CornerRadius="6"
                    Background="{DynamicResource WarningBackground}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{DynamicResource WarningBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Plugins_RestartNote]}"
                               FontSize="12" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"
                               />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
