<UserControl x:Class="SwiftList.App.Views.Settings.ExclusionSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:SwiftList.App.Services"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SwiftList.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="RuleTextBox" TargetType="TextBox">
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style x:Key="RuleBulkTextBox" TargetType="TextBox" BasedOn="{StaticResource RuleTextBox}">
                <Setter Property="Height" Value="132"/>
                <Setter Property="AcceptsReturn" Value="True"/>
                <Setter Property="AcceptsTab" Value="True"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Microsoft YaHei UI"/>
            </Style>

            <Style x:Key="RuleIconButton" TargetType="Button">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary2}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="RuleItemTemplate">
                <Border BorderBrush="{DynamicResource SettingsRowBorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"
                                   Foreground="{DynamicResource TextPrimary2}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="&#xE70F;" 
                                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_EditTooltip]}" 
                                    Style="{StaticResource RuleIconButton}"
                                    Command="{Binding DataContext.Exclusions.EditPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="&#xE74D;" 
                                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_RemoveTooltip]}" 
                                    Style="{StaticResource RuleIconButton}"
                                    Command="{Binding DataContext.Exclusions.RemovePathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="GlobItemTemplate">
                <Border BorderBrush="{DynamicResource SettingsRowBorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"
                                   Foreground="{DynamicResource TextPrimary2}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="&#xE70F;" 
                                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_EditTooltip]}" 
                                    Style="{StaticResource RuleIconButton}"
                                    Command="{Binding DataContext.Exclusions.EditGlobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="&#xE74D;" 
                                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_RemoveTooltip]}" 
                                    Style="{StaticResource RuleIconButton}"
                                    Command="{Binding DataContext.Exclusions.RemoveGlobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="RegexItemTemplate">
                <Border BorderBrush="{DynamicResource SettingsRowBorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"
                                   Foreground="{DynamicResource TextPrimary2}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="&#xE70F;" 
                                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_EditTooltip]}" 
                                    Style="{StaticResource RuleIconButton}"
                                    Command="{Binding DataContext.Exclusions.EditRegexCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="&#xE74D;" 
                                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_RemoveTooltip]}" 
                                    Style="{StaticResource RuleIconButton}"
                                    Command="{Binding DataContext.Exclusions.RemoveRegexCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Style="{StaticResource SettingsSectionTitle}" 
                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_Title]}"/>
            <TextBlock Style="{StaticResource SettingsHintText}" 
                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_Hint]}"/>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_PathCardTitle]}" 
                               FontWeight="SemiBold" FontSize="13" FontFamily="Microsoft YaHei UI"/>
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_PathCardDesc]}"
                               Style="{StaticResource SettingsHintText}" Margin="0,4,0,10"/>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" 
                                Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_AddBtn]}" 
                                Style="{StaticResource PrimarySettingsButton}"
                                Command="{Binding Exclusions.AddPathCommand}" Margin="10,0,0,0"/>
                        <TextBox Style="{StaticResource RuleTextBox}"
                                 Text="{Binding Exclusions.NewExcludedPath, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Exclusions.ExcludedPaths}" ItemTemplate="{StaticResource RuleItemTemplate}"/>
                    <TextBox Style="{StaticResource RuleBulkTextBox}" Margin="0,10,0,8"
                             Text="{Binding Exclusions.ExcludedPathsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_GenerateBtn]}" 
                                Style="{StaticResource SettingsButton}"
                                Command="{Binding Exclusions.ExportPathsTextCommand}" Margin="0,0,8,0"/>
                        <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_ApplyBtn]}" 
                                Style="{StaticResource PrimarySettingsButton}"
                                Command="{Binding Exclusions.ApplyPathsTextCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_GlobCardTitle]}" 
                               FontWeight="SemiBold" FontSize="13" FontFamily="Microsoft YaHei UI"/>
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_GlobCardDesc]}"
                               Style="{StaticResource SettingsHintText}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" 
                                Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_AddBtn]}" 
                                Style="{StaticResource PrimarySettingsButton}"
                                Command="{Binding Exclusions.AddGlobCommand}" Margin="10,0,0,0"/>
                        <TextBox Style="{StaticResource RuleTextBox}"
                                 Text="{Binding Exclusions.NewIgnoredGlob, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Exclusions.IgnoredGlobs}" ItemTemplate="{StaticResource GlobItemTemplate}"/>
                    <TextBox Style="{StaticResource RuleBulkTextBox}" Margin="0,10,0,8"
                             Text="{Binding Exclusions.IgnoredGlobsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_GenerateBtn]}" 
                                Style="{StaticResource SettingsButton}"
                                Command="{Binding Exclusions.ExportGlobsTextCommand}" Margin="0,0,8,0"/>
                        <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_ApplyBtn]}" 
                                Style="{StaticResource PrimarySettingsButton}"
                                Command="{Binding Exclusions.ApplyGlobsTextCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_RegexCardTitle]}" 
                               FontWeight="SemiBold" FontSize="13" FontFamily="Microsoft YaHei UI"/>
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_RegexCardDesc]}"
                               Style="{StaticResource SettingsHintText}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" 
                                Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_AddBtn]}" 
                                Style="{StaticResource PrimarySettingsButton}"
                                Command="{Binding Exclusions.AddRegexCommand}" Margin="10,0,0,0"/>
                        <TextBox Style="{StaticResource RuleTextBox}"
                                 Text="{Binding Exclusions.NewIgnoredRegex, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Exclusions.IgnoredRegexes}" ItemTemplate="{StaticResource RegexItemTemplate}"/>
                    <TextBox Style="{StaticResource RuleBulkTextBox}" Margin="0,10,0,8"
                             Text="{Binding Exclusions.IgnoredRegexesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_GenerateBtn]}" 
                                Style="{StaticResource SettingsButton}"
                                Command="{Binding Exclusions.ExportRegexesTextCommand}" Margin="0,0,8,0"/>
                        <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_ApplyBtn]}" 
                                Style="{StaticResource PrimarySettingsButton}"
                                Command="{Binding Exclusions.ApplyRegexesTextCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_AboutTitle]}" 
                               FontWeight="SemiBold" FontSize="13" FontFamily="Microsoft YaHei UI" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_AboutDesc1]}"
                               Style="{StaticResource SettingsHintText}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_AboutDesc2]}"
                               Style="{StaticResource SettingsHintText}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
