<Window x:Class="SwiftList.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SwiftList.App.Views.Controls"
        xmlns:settings="clr-namespace:SwiftList.App.Views.Settings"
        xmlns:plugins="clr-namespace:SwiftList.App.Views.Settings.Plugins"
        xmlns:services="clr-namespace:SwiftList.App.Services"
        Title="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_Title]}"
        Height="650" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Icon="pack://application:,,,/SwiftList.App;component/logo.png">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SwiftList.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/SearchWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="10" Background="{DynamicResource ContentBg}"
            BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.2" Color="{DynamicResource ShadowColor}"/>
        </Border.Effect>
        <Border CornerRadius="10" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="52"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                        CornerRadius="9,9,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Image Source="pack://application:,,,/SwiftList.App;component/logo.png" Width="20" Height="20" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_Title]}" 
                                        FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary2}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0">
                            <Button Content="&#xE949;" Style="{StaticResource WindowControlButton}" Click="BtnMinimize_Click"/>
                            <Button Content="&#xE8BB;" Style="{StaticResource CloseButton}" Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
                        <ListBox x:Name="LstSections" BorderThickness="0" Background="Transparent" Margin="0,14"
                                 FontSize="15"
                                 ItemContainerStyle="{StaticResource SidebarItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="LstSections_SelectionChanged">
                            <ListBoxItem Tag="Service">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_Service]}"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="Index">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8EF;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_Index]}"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="Exclusions">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_Exclusions]}"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="General">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_General]}"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="Hotkeys">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_Hotkeys]}"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="Blacklist">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_Blacklist]}"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="Plugins">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xECAA;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_Plugins]}"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="Favorites">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE728;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_Favorites]}"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="History">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_History]}"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="About">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_About]}"/>
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </Border>

                    <Grid Grid.Column="1" Margin="24,20,24,16">
                        <settings:ServiceSettingsPage x:Name="PageService" Visibility="Collapsed"/>
                        <settings:IndexSettingsPage x:Name="PageIndex"/>
                        <settings:ExclusionSettingsPage x:Name="PageExclusions" Visibility="Collapsed"/>
                        <settings:GeneralSettingsPage x:Name="PageGeneral" Visibility="Collapsed"/>
                        <settings:HotkeySettingsPage x:Name="PageHotkeys" Visibility="Collapsed"
                                                      DataContext="{Binding Hotkeys}"/>
                        <settings:BlacklistSettingsPage x:Name="PageBlacklist" Visibility="Collapsed"
                                                        DataContext="{Binding Blacklist}"/>
                        <plugins:PluginManagementSettingsPage x:Name="PagePlugins" Visibility="Collapsed"
                                                              DataContext="{Binding Plugins}"/>
                        <settings:HistorySettingsPage x:Name="PageHistory" Visibility="Collapsed"
                                                      DataContext="{Binding History}"/>
                        <settings:FavoritesSettingsPage x:Name="PageFavorites" Visibility="Collapsed"
                                                        DataContext="{Binding Favorites}"/>
                        <settings:AboutSettingsPage x:Name="PageAbout" Visibility="Collapsed"/>
                    </Grid>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource StatusBarBg}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,9,9">
                    <Grid Margin="16,0">
                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_SaveTip]}" 
                                   Foreground="{DynamicResource TextSecondary2}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource SettingsButton}" 
                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_Cancel]}" 
                                    Click="BtnClose_Click"/>
                            <Button Style="{StaticResource SettingsButton}" 
                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_Apply]}" 
                                    Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}"/>
                            <Button Style="{StaticResource PrimarySettingsButton}" 
                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_OK]}" 
                                    Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
