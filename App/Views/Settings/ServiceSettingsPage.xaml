<UserControl x:Class="SwiftList.App.Views.Settings.ServiceSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:services="clr-namespace:SwiftList.App.Services"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SwiftList.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Style="{StaticResource SettingsSectionTitle}" 
                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Service_Title]}"/>
            <TextBlock Style="{StaticResource SettingsHintText}" 
                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Service_Hint]}"/>
            
            <Border Style="{StaticResource SettingsCard}" Margin="0,16,0,16" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Visual indicator (Heartbeat / Ring / Alert) -->
                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                        <!-- Loading Ring -->
                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" 
                                   Foreground="{DynamicResource AccentBlue}" FontSize="32" 
                                   RenderTransformOrigin="0.5,0.5"
                                   Visibility="{Binding Service.ProgressBarVisibility}">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </TextBlock.RenderTransform>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Service.ProgressBarVisibility}" Value="Visible">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         From="0" To="360" Duration="0:0:1.5" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        
                        <!-- Error icon (when not loading and error is visible) -->
                        <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource ErrorBackground}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding Service.ErrorIconVisibility}">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" 
                                       Foreground="{DynamicResource ErrorBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <!-- Normal Checkmark (when not loading and error is collapsed) -->
                        <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource SuccessBadgeBackground}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Service.ErrorIconVisibility}" Value="Collapsed"/>
                                                <Condition Binding="{Binding Service.ProgressBarVisibility}" Value="Collapsed"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" 
                                       Foreground="{DynamicResource SuccessBadgeText}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    
                    <!-- Title & description -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Service.LoadingTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary2}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Service.LoadingStats}" FontSize="12" Foreground="{DynamicResource TextSecondary2}" TextWrapping="Wrap"/>
                    </StackPanel>
                    
                    <!-- Action Button -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimarySettingsButton}" 
                                Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Service_ActionInstall]}" 
                                Height="38"
                                Padding="22,0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Command="{Binding Service.InstallServiceCommand}" 
                                Visibility="{Binding Service.InstallButtonVisibility}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Service Architecture Info Card -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Service_AboutTitle]}" 
                               FontWeight="SemiBold" FontSize="13"  Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Service_AboutDesc]}" 
                               FontSize="12" Foreground="{DynamicResource TextSecondary2}" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    
                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SeparatorBrush}" Margin="0,4,0,12"/>
                    
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Service_AdvTitle]}" 
                               FontWeight="SemiBold" FontSize="12"  Margin="0,0,0,8"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SuccessBadgeText}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Service_Adv1Title]}" 
                                   FontSize="12" Foreground="{DynamicResource TextPrimary2}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Service_Adv1Desc]}" 
                                   FontSize="11" Foreground="{DynamicResource TextSecondary2}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SuccessBadgeText}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Service_Adv2Title]}" 
                                   FontSize="12" Foreground="{DynamicResource TextPrimary2}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Service_Adv2Desc]}" 
                                   FontSize="11" Foreground="{DynamicResource TextSecondary2}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SuccessBadgeText}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Service_Adv3Title]}" 
                                   FontSize="12" Foreground="{DynamicResource TextPrimary2}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Service_Adv3Desc]}" 
                                   FontSize="11" Foreground="{DynamicResource TextSecondary2}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
