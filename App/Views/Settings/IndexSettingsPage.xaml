<UserControl x:Class="SwiftList.App.Views.Settings.IndexSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:SwiftList.App.Services"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SwiftList.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <DataTemplate x:Key="LocalDriveTemplate">
                <Border Style="{StaticResource SettingsRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/><ColumnDefinition Width="70"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" IsEnabled="{Binding CanEditEnabled}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Kind}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding State}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="{Binding ItemCount}" VerticalAlignment="Center"/>
                        <Button Grid.Column="5"
                                Style="{StaticResource SettingsButton}"
                                MinWidth="72"
                                Height="28"
                                Padding="10,0"
                                Content="{Binding RowActionText}"
                                Command="{Binding RowActionCommand}"
                                IsEnabled="{Binding CanRunRowAction}"
                                Visibility="{Binding IsRowActionVisible, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="NetworkDriveTemplate">
                <Border Style="{StaticResource SettingsRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1.4*" MinWidth="126"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditEnabled}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Drive, StringFormat={}{0}:}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding State}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding ItemCount}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="4"
                                  Width="116"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource SettingsComboBox}"
                                  ItemsSource="{Binding DataContext.NetworkDrive.RefreshModeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding RefreshMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding CanEditRefreshMode}"/>
                        <Button Grid.Column="5"
                                Style="{StaticResource SettingsButton}"
                                MinWidth="72"
                                Height="28"
                                Padding="10,0"
                                Content="{Binding RowActionText}"
                                Command="{Binding RowActionCommand}"
                                IsEnabled="{Binding CanRunRowAction}"
                                Visibility="{Binding IsRowActionVisible, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="WslDriveTemplate">
                <Border Style="{StaticResource SettingsRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1.4*" MinWidth="126"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditEnabled}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding DistroName}" FontSize="13" VerticalAlignment="Center" ToolTip="{Binding UncPath}"/>
                        <TextBlock Grid.Column="2" Text="{Binding State}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding ItemCount}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="4"
                                  Width="116"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource SettingsComboBox}"
                                  ItemsSource="{Binding DataContext.NetworkDrive.RefreshModeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding RefreshMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding CanEditRefreshMode}"/>
                        <Button Grid.Column="5"
                                Style="{StaticResource SettingsButton}"
                                MinWidth="72"
                                Height="28"
                                Padding="10,0"
                                Content="{Binding RowActionText}"
                                Command="{Binding RowActionCommand}"
                                IsEnabled="{Binding CanRunRowAction}"
                                Visibility="{Binding IsRowActionVisible, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Grid.IsSharedSizeScope="True">
            <TextBlock Style="{StaticResource SettingsSectionTitle}"
                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_Index]}"/>
            <TextBlock Style="{StaticResource SettingsHintText}"
                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Index_Hint]}"/>

            <!-- Tab header row -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <StackPanel Margin="0,0,28,0">
                    <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalDrive]}"
                            Command="{Binding LocalDrive.SelectTabCommand}" CommandParameter="Local">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabHeaderButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LocalDrive.SelectedTab}" Value="Local">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource TabUnderlineStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LocalDrive.SelectedTab}" Value="Local">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
                <StackPanel>
                    <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_NetworkDrive]}"
                            Command="{Binding LocalDrive.SelectTabCommand}" CommandParameter="Network">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabHeaderButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LocalDrive.SelectedTab}" Value="Network">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource TabUnderlineStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LocalDrive.SelectedTab}" Value="Network">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
                <StackPanel Margin="28,0,0,0"
                            Visibility="{Binding NetworkDrive.IsWslPanelVisible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_WslSectionTitle]}"
                            Command="{Binding LocalDrive.SelectTabCommand}" CommandParameter="Wsl">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabHeaderButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LocalDrive.SelectedTab}" Value="Wsl">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource TabUnderlineStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LocalDrive.SelectedTab}" Value="Wsl">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
            </StackPanel>
            <Border Height="1" Background="{DynamicResource SettingsRowBorderBrush}" Margin="0,0,0,15"/>

            <!-- Tab: Local -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LocalDrive.SelectedTab}" Value="Local">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Style="{StaticResource SettingsHintText}" Margin="0,0,0,12"
                           Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_Hint]}"/>

                <Border Style="{StaticResource SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_IndexStatus]}"
                                       FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{Binding LocalDrive.IndexSummary}"
                                       Foreground="{DynamicResource TextSecondary2}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimarySettingsButton}"
                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_RebuildBtn]}"
                                    Command="{Binding LocalDrive.RebuildCommand}" IsEnabled="{Binding LocalDrive.CanRebuild}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/><ColumnDefinition Width="70"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_HeaderDrive]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_HeaderFileSystem]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_HeaderStatus]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                            <TextBlock Grid.Column="4"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_HeaderItems]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                        </Grid>

                        <!-- Empty Placeholder Item -->
                        <Border Background="{DynamicResource EmptyPlaceholderBackground}" BorderBrush="{DynamicResource EmptyPlaceholderBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="24,32" Margin="0,8,0,0"
                                Visibility="{Binding LocalDrive.IsLocalDrivesEmpty, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="{DynamicResource EmptyPlaceholderIcon}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding LocalDrive.DrivesPlaceholderText}" FontSize="13" Foreground="{DynamicResource TextSecondary2}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding LocalDrive.LocalDrives}" ItemTemplate="{StaticResource LocalDriveTemplate}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Tab: Network -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LocalDrive.SelectedTab}" Value="Network">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Style="{StaticResource SettingsHintText}" Margin="0,0,0,12"
                           Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_Hint]}"/>

                <Border Style="{StaticResource SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_IndexStatus]}"
                                       FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{Binding NetworkDrive.IndexSummary}"
                                       Foreground="{DynamicResource TextSecondary2}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimarySettingsButton}"
                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_RebuildBtn]}"
                                    Command="{Binding NetworkDrive.RebuildCommand}"
                                    IsEnabled="{Binding NetworkDrive.CanRebuild}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.4*" MinWidth="126"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_HeaderDrive]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_HeaderStatus]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_HeaderItems]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                            <TextBlock Grid.Column="4"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_HeaderMode]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                        </Grid>
                        <Border Background="{DynamicResource EmptyPlaceholderBackground}" BorderBrush="{DynamicResource EmptyPlaceholderBorderBrush}" BorderThickness="1" CornerRadius="6"
                                Padding="24,32" Margin="0,8,0,0"
                                Visibility="{Binding NetworkDrive.IsNetworkDrivesEmpty, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                                           Foreground="{DynamicResource EmptyPlaceholderIcon}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding NetworkDrive.DrivesPlaceholderText}" FontSize="13"
                                           Foreground="{DynamicResource TextSecondary2}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding NetworkDrive.NetworkDrives}" ItemTemplate="{StaticResource NetworkDriveTemplate}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Tab: WSL -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LocalDrive.SelectedTab}" Value="Wsl">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Style="{StaticResource SettingsHintText}" Margin="0,0,0,12"
                           Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_WslSectionHint]}"/>

                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.4*" MinWidth="126"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_WslHeaderDistro]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_HeaderStatus]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_HeaderItems]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                            <TextBlock Grid.Column="4"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_HeaderMode]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding NetworkDrive.WslDrives}" ItemTemplate="{StaticResource WslDriveTemplate}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
