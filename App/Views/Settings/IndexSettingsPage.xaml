<UserControl x:Class="SwiftList.App.Views.Settings.IndexSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:SwiftList.App.Services"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SwiftList.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <Style x:Key="RuleTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="10,6"/>

                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style x:Key="RuleBulkTextBox" TargetType="TextBox" BasedOn="{StaticResource RuleTextBox}">
                <Setter Property="Height" Value="132"/>
                <Setter Property="AcceptsReturn" Value="True"/>
                <Setter Property="AcceptsTab" Value="True"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            </Style>

            <Style x:Key="RuleIconButton" TargetType="Button">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary2}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="RuleItemTemplate">
                <Border BorderBrush="{DynamicResource SettingsRowBorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"
                                   Foreground="{DynamicResource TextPrimary2}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="&#xE70F;"
                                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_EditTooltip]}"
                                    Style="{StaticResource RuleIconButton}"
                                    Command="{Binding DataContext.Exclusions.EditPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="&#xE74D;"
                                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_RemoveTooltip]}"
                                    Style="{StaticResource RuleIconButton}"
                                    Command="{Binding DataContext.Exclusions.RemovePathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="GlobItemTemplate">
                <Border BorderBrush="{DynamicResource SettingsRowBorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"
                                   Foreground="{DynamicResource TextPrimary2}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="&#xE70F;"
                                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_EditTooltip]}"
                                    Style="{StaticResource RuleIconButton}"
                                    Command="{Binding DataContext.Exclusions.EditGlobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="&#xE74D;"
                                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_RemoveTooltip]}"
                                    Style="{StaticResource RuleIconButton}"
                                    Command="{Binding DataContext.Exclusions.RemoveGlobCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="RegexItemTemplate">
                <Border BorderBrush="{DynamicResource SettingsRowBorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"
                                   Foreground="{DynamicResource TextPrimary2}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="&#xE70F;"
                                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_EditTooltip]}"
                                    Style="{StaticResource RuleIconButton}"
                                    Command="{Binding DataContext.Exclusions.EditRegexCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="&#xE74D;"
                                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_RemoveTooltip]}"
                                    Style="{StaticResource RuleIconButton}"
                                    Command="{Binding DataContext.Exclusions.RemoveRegexCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="LocalDriveTemplate">
                <Border Style="{StaticResource SettingsRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/><ColumnDefinition Width="70"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" IsEnabled="{Binding CanEditEnabled}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Kind}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding State}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="{Binding ItemCount}" VerticalAlignment="Center"/>
                        <Button Grid.Column="5"
                                Style="{StaticResource SettingsButton}"
                                MinWidth="72"
                                Height="28"
                                Padding="10,0"
                                Content="{Binding RowActionText}"
                                Command="{Binding RowActionCommand}"
                                IsEnabled="{Binding CanRunRowAction}"
                                Visibility="{Binding IsRowActionVisible, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="NetworkDriveTemplate">
                <Border Style="{StaticResource SettingsRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1.4*" MinWidth="126"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditEnabled}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Drive, StringFormat={}{0}:}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding State}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding ItemCount}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="4"
                                  Width="116"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource SettingsComboBox}"
                                  ItemsSource="{Binding DataContext.NetworkDrive.RefreshModeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding RefreshMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding CanEditRefreshMode}"/>
                        <Button Grid.Column="5"
                                Style="{StaticResource SettingsButton}"
                                MinWidth="72"
                                Height="28"
                                Padding="10,0"
                                Content="{Binding RowActionText}"
                                Command="{Binding RowActionCommand}"
                                IsEnabled="{Binding CanRunRowAction}"
                                Visibility="{Binding IsRowActionVisible, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="WslDriveTemplate">
                <Border Style="{StaticResource SettingsRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1.4*" MinWidth="126"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditEnabled}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding DistroName}" FontSize="13" VerticalAlignment="Center" ToolTip="{Binding UncPath}"/>
                        <TextBlock Grid.Column="2" Text="{Binding State}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding ItemCount}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="4"
                                  Width="116"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource SettingsComboBox}"
                                  ItemsSource="{Binding DataContext.NetworkDrive.RefreshModeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding RefreshMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding CanEditRefreshMode}"/>
                        <Button Grid.Column="5"
                                Style="{StaticResource SettingsButton}"
                                MinWidth="72"
                                Height="28"
                                Padding="10,0"
                                Content="{Binding RowActionText}"
                                Command="{Binding RowActionCommand}"
                                IsEnabled="{Binding CanRunRowAction}"
                                Visibility="{Binding IsRowActionVisible, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="FolderIndexTemplate">
                <Border Style="{StaticResource SettingsRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1.4*" MinWidth="126"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditEnabled}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="13" VerticalAlignment="Center" ToolTip="{Binding Path}"/>
                        <TextBlock Grid.Column="2" Text="{Binding State}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding ItemCount}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="4"
                                  Width="116"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource SettingsComboBox}"
                                  ItemsSource="{Binding DataContext.NetworkDrive.RefreshModeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding RefreshMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding CanEditRefreshMode}"/>
                        <Button Grid.Column="5"
                                Style="{StaticResource SettingsButton}"
                                MinWidth="72"
                                Height="28"
                                Padding="10,0"
                                Content="{Binding RowActionText}"
                                Command="{Binding RowActionCommand}"
                                IsEnabled="{Binding CanRunRowAction}"
                                Visibility="{Binding IsRowActionVisible, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Grid.IsSharedSizeScope="True">
            <TextBlock Style="{StaticResource SettingsSectionTitle}"
                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_Index]}"/>
            <TextBlock Style="{StaticResource SettingsHintText}"
                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Index_Hint]}"/>

            <!-- Tab header row -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <StackPanel Margin="0,0,28,0">
                    <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_LocalDrive]}"
                            Command="{Binding LocalDrive.SelectTabCommand}" CommandParameter="Local">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabHeaderButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LocalDrive.SelectedTab}" Value="Local">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource TabUnderlineStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LocalDrive.SelectedTab}" Value="Local">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
                <StackPanel>
                    <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_NetworkDrive]}"
                            Command="{Binding LocalDrive.SelectTabCommand}" CommandParameter="Network">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabHeaderButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LocalDrive.SelectedTab}" Value="Network">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource TabUnderlineStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LocalDrive.SelectedTab}" Value="Network">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
                <StackPanel Margin="28,0,0,0"
                            Visibility="{Binding NetworkDrive.IsWslPanelVisible, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_WslSectionTitle]}"
                            Command="{Binding LocalDrive.SelectTabCommand}" CommandParameter="Wsl">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabHeaderButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LocalDrive.SelectedTab}" Value="Wsl">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource TabUnderlineStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LocalDrive.SelectedTab}" Value="Wsl">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
                <StackPanel Margin="28,0,0,0">
                    <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_FolderIndex]}"
                            Command="{Binding LocalDrive.SelectTabCommand}" CommandParameter="Folders">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabHeaderButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LocalDrive.SelectedTab}" Value="Folders">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource TabUnderlineStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LocalDrive.SelectedTab}" Value="Folders">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
                <StackPanel Margin="28,0,0,0">
                    <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_Exclusions]}"
                            Command="{Binding LocalDrive.SelectTabCommand}" CommandParameter="Exclusions">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabHeaderButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LocalDrive.SelectedTab}" Value="Exclusions">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource TabUnderlineStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LocalDrive.SelectedTab}" Value="Exclusions">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
            </StackPanel>
            <Border Height="1" Background="{DynamicResource SettingsRowBorderBrush}" Margin="0,0,0,15"/>

            <!-- Tab: Local -->
            <StackPanel x:Name="TabLocal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LocalDrive.SelectedTab}" Value="Local">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Style="{StaticResource SettingsHintText}" Margin="0,0,0,12"
                           Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_Hint]}"/>

                <Border x:Name="RowLocalRebuild" Style="{StaticResource SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_IndexStatus]}"
                                       FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{Binding LocalDrive.IndexSummary}"
                                       Foreground="{DynamicResource TextSecondary2}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimarySettingsButton}"
                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_RebuildBtn]}"
                                    Command="{Binding LocalDrive.RebuildCommand}" IsEnabled="{Binding LocalDrive.CanRebuild}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/><ColumnDefinition Width="70"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_HeaderDrive]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_HeaderFileSystem]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_HeaderStatus]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                            <TextBlock Grid.Column="4"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_HeaderItems]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                        </Grid>

                        <!-- Empty Placeholder Item -->
                        <Border Background="{DynamicResource EmptyPlaceholderBackground}" BorderBrush="{DynamicResource EmptyPlaceholderBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="24,32" Margin="0,8,0,0"
                                Visibility="{Binding LocalDrive.IsLocalDrivesEmpty, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="{DynamicResource EmptyPlaceholderIcon}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding LocalDrive.DrivesPlaceholderText}" FontSize="13" Foreground="{DynamicResource TextSecondary2}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding LocalDrive.LocalDrives}" ItemTemplate="{StaticResource LocalDriveTemplate}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Tab: Network -->
            <StackPanel x:Name="TabNetwork">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LocalDrive.SelectedTab}" Value="Network">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Style="{StaticResource SettingsHintText}" Margin="0,0,0,12"
                           Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_Hint]}"/>

                <Border x:Name="RowNetworkRebuild" Style="{StaticResource SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_IndexStatus]}"
                                       FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{Binding NetworkDrive.NetworkIndexSummary}"
                                       Foreground="{DynamicResource TextSecondary2}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimarySettingsButton}"
                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_RebuildBtn]}"
                                    Command="{Binding NetworkDrive.RebuildDrivesCommand}"
                                    IsEnabled="{Binding NetworkDrive.CanRebuildDrives}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.4*" MinWidth="126"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_HeaderDrive]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_HeaderStatus]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_HeaderItems]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                            <TextBlock Grid.Column="4"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_HeaderMode]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                        </Grid>
                        <Border Background="{DynamicResource EmptyPlaceholderBackground}" BorderBrush="{DynamicResource EmptyPlaceholderBorderBrush}" BorderThickness="1" CornerRadius="6"
                                Padding="24,32" Margin="0,8,0,0"
                                Visibility="{Binding NetworkDrive.IsNetworkDrivesEmpty, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                                           Foreground="{DynamicResource EmptyPlaceholderIcon}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding NetworkDrive.DrivesPlaceholderText}" FontSize="13"
                                           Foreground="{DynamicResource TextSecondary2}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding NetworkDrive.NetworkDrives}" ItemTemplate="{StaticResource NetworkDriveTemplate}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Tab: WSL -->
            <StackPanel x:Name="TabWsl">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LocalDrive.SelectedTab}" Value="Wsl">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Style="{StaticResource SettingsHintText}" Margin="0,0,0,12"
                           Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_WslSectionHint]}"/>

                <Border x:Name="RowWslRebuild" Style="{StaticResource SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_IndexStatus]}"
                                       FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{Binding NetworkDrive.WslIndexSummary}"
                                       Foreground="{DynamicResource TextSecondary2}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimarySettingsButton}"
                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_RebuildBtn]}"
                                    Command="{Binding NetworkDrive.RebuildWslCommand}"
                                    IsEnabled="{Binding NetworkDrive.CanRebuildWsl}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.4*" MinWidth="126"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_WslHeaderDistro]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_HeaderStatus]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_HeaderItems]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                            <TextBlock Grid.Column="4"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_HeaderMode]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding NetworkDrive.WslDrives}" ItemTemplate="{StaticResource WslDriveTemplate}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Tab: Folders -->
            <StackPanel x:Name="TabFolders">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LocalDrive.SelectedTab}" Value="Folders">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Style="{StaticResource SettingsHintText}" Margin="0,0,0,12"
                           Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Folder_SectionHint]}"/>

                <Border x:Name="RowFolderRebuild" Style="{StaticResource SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_IndexStatus]}"
                                       FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{Binding NetworkDrive.FolderIndexSummary}"
                                       Foreground="{DynamicResource TextSecondary2}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimarySettingsButton}" Margin="0,0,8,0"
                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_RebuildBtn]}"
                                    Command="{Binding NetworkDrive.RebuildFoldersCommand}"
                                    IsEnabled="{Binding NetworkDrive.CanRebuildFolders}"
                                    Visibility="{Binding NetworkDrive.HasFolderIndexes, Converter={StaticResource BoolToVis}}"/>
                            <Button Style="{StaticResource PrimarySettingsButton}"
                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Folder_AddBtn]}"
                                    Command="{Binding NetworkDrive.AddFolderCommand}"
                                    IsEnabled="{Binding NetworkDrive.CanAddFolder}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.4*" MinWidth="126"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Folder_HeaderPath]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_HeaderStatus]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_HeaderItems]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                            <TextBlock Grid.Column="4"
                                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Network_HeaderMode]}"
                                       Foreground="{DynamicResource TextSecondary2}"/>
                        </Grid>
                        <Border Background="{DynamicResource EmptyPlaceholderBackground}" BorderBrush="{DynamicResource EmptyPlaceholderBorderBrush}" BorderThickness="1" CornerRadius="6"
                                Padding="24,32" Margin="0,8,0,0"
                                Visibility="{Binding NetworkDrive.IsFolderIndexesEmpty, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                                           Foreground="{DynamicResource EmptyPlaceholderIcon}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Folder_Placeholder]}" FontSize="13"
                                           Foreground="{DynamicResource TextSecondary2}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding NetworkDrive.FolderIndexes}" ItemTemplate="{StaticResource FolderIndexTemplate}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Tab: Exclusions -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LocalDrive.SelectedTab}" Value="Exclusions">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Style="{StaticResource SettingsHintText}" Margin="0,0,0,12" TextWrapping="Wrap"
                           Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_Hint]}"/>

                <!-- Sub-tab header row -->
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,24,0">
                        <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_TabPath]}"
                                Command="{Binding Exclusions.SelectSubTabCommand}" CommandParameter="Path">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabHeaderButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Exclusions.SelectedSubTab}" Value="Path">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource TabUnderlineStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Exclusions.SelectedSubTab}" Value="Path">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_TabGlob]}"
                                Command="{Binding Exclusions.SelectSubTabCommand}" CommandParameter="Glob">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabHeaderButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Exclusions.SelectedSubTab}" Value="Glob">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource TabUnderlineStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Exclusions.SelectedSubTab}" Value="Glob">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_TabRegex]}"
                                Command="{Binding Exclusions.SelectSubTabCommand}" CommandParameter="Regex">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabHeaderButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Exclusions.SelectedSubTab}" Value="Regex">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource TabUnderlineStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Exclusions.SelectedSubTab}" Value="Regex">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <Border Height="1" Background="{DynamicResource SettingsRowBorderBrush}" Margin="0,0,0,15"/>

                <!-- Sub-tab: Path -->
                <StackPanel x:Name="SubTabExclusionsPath">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Exclusions.SelectedSubTab}" Value="Path">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_PathCardDesc]}"
                                       Style="{StaticResource SettingsHintText}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right"
                                        Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_AddBtn]}"
                                        Style="{StaticResource PrimarySettingsButton}"
                                        Command="{Binding Exclusions.AddPathCommand}" Margin="10,0,0,0"/>
                                <TextBox Style="{StaticResource RuleTextBox}"
                                         Text="{Binding Exclusions.NewExcludedPath, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Exclusions.ExcludedPaths}" ItemTemplate="{StaticResource RuleItemTemplate}"/>
                            <TextBox Style="{StaticResource RuleBulkTextBox}" Margin="0,10,0,8"
                                     Text="{Binding Exclusions.ExcludedPathsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_GenerateBtn]}"
                                        Style="{StaticResource SettingsButton}"
                                        Command="{Binding Exclusions.ExportPathsTextCommand}" Margin="0,0,8,0"/>
                                <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_ApplyBtn]}"
                                        Style="{StaticResource PrimarySettingsButton}"
                                        Command="{Binding Exclusions.ApplyPathsTextCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Sub-tab: Glob -->
                <StackPanel x:Name="SubTabExclusionsGlob">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Exclusions.SelectedSubTab}" Value="Glob">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_GlobCardDesc]}"
                                       Style="{StaticResource SettingsHintText}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right"
                                        Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_AddBtn]}"
                                        Style="{StaticResource PrimarySettingsButton}"
                                        Command="{Binding Exclusions.AddGlobCommand}" Margin="10,0,0,0"/>
                                <TextBox Style="{StaticResource RuleTextBox}"
                                         Text="{Binding Exclusions.NewIgnoredGlob, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Exclusions.IgnoredGlobs}" ItemTemplate="{StaticResource GlobItemTemplate}"/>
                            <TextBox Style="{StaticResource RuleBulkTextBox}" Margin="0,10,0,8"
                                     Text="{Binding Exclusions.IgnoredGlobsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_GenerateBtn]}"
                                        Style="{StaticResource SettingsButton}"
                                        Command="{Binding Exclusions.ExportGlobsTextCommand}" Margin="0,0,8,0"/>
                                <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_ApplyBtn]}"
                                        Style="{StaticResource PrimarySettingsButton}"
                                        Command="{Binding Exclusions.ApplyGlobsTextCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Sub-tab: Regex -->
                <StackPanel x:Name="SubTabExclusionsRegex">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Exclusions.SelectedSubTab}" Value="Regex">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_RegexCardDesc]}"
                                       Style="{StaticResource SettingsHintText}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right"
                                        Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_AddBtn]}"
                                        Style="{StaticResource PrimarySettingsButton}"
                                        Command="{Binding Exclusions.AddRegexCommand}" Margin="10,0,0,0"/>
                                <TextBox Style="{StaticResource RuleTextBox}"
                                         Text="{Binding Exclusions.NewIgnoredRegex, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Exclusions.IgnoredRegexes}" ItemTemplate="{StaticResource RegexItemTemplate}"/>
                            <TextBox Style="{StaticResource RuleBulkTextBox}" Margin="0,10,0,8"
                                     Text="{Binding Exclusions.IgnoredRegexesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_GenerateBtn]}"
                                        Style="{StaticResource SettingsButton}"
                                        Command="{Binding Exclusions.ExportRegexesTextCommand}" Margin="0,0,8,0"/>
                                <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_ApplyBtn]}"
                                        Style="{StaticResource PrimarySettingsButton}"
                                        Command="{Binding Exclusions.ApplyRegexesTextCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
