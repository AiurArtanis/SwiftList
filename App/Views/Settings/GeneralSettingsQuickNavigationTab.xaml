<UserControl x:Class="SwiftList.App.Views.Settings.GeneralSettingsQuickNavigationTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:SwiftList.App.Services"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="700">
    <!-- Split out of GeneralSettingsPage.xaml (the "Quick Navigation" tab) to keep that file under the
         project's line-count convention. DataContext is inherited from the host page, so the
         General.Xxx bindings below resolve exactly as they did when this content lived inline.
         QuickNavItemTemplate/QuickNavIconButton moved here (not duplicated) since this tab was their
         only consumer once it left the parent page. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SwiftList.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Mirrors FavoritesSettingsPage.xaml's own FavIconButton exactly: same small square icon
                 button used for its Move Up/Down actions, but defined locally rather than shared across
                 UserControls, matching how SettingsTextBox is page-local elsewhere in this settings area. -->
            <Style x:Key="QuickNavIconButton" TargetType="Button">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary2}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="QuickNavItemTemplate">
                <Border BorderBrush="{DynamicResource SettingsRowBorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary2}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="&#xE74A;"
                                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Favorites_MoveUpTooltip]}"
                                    Style="{StaticResource QuickNavIconButton}"
                                    Command="{Binding DataContext.General.QuickNavigationOrder.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="&#xE74B;"
                                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Favorites_MoveDownTooltip]}"
                                    Style="{StaticResource QuickNavIconButton}"
                                    Command="{Binding DataContext.General.QuickNavigationOrder.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource SettingsHintText}" Margin="0,0,0,12"
                    Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_QuickNavHint]}"/>

        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <TextBlock x:Name="RowQuickNavList" Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[General_QuickNavListTitle]}"
                           FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>

                <ItemsControl ItemsSource="{Binding General.QuickNavigationOrder.Items}" ItemTemplate="{StaticResource QuickNavItemTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
