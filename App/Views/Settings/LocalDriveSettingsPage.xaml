<UserControl x:Class="SwiftList.App.Views.Settings.LocalDriveSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:services="clr-namespace:SwiftList.App.Services"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SwiftList.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <DataTemplate x:Key="LocalDriveTemplate">
                <Border Style="{StaticResource SettingsRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/><ColumnDefinition Width="80"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.1*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" IsEnabled="{Binding DataContext.LocalDrive.IsDriveCheckboxEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Kind}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding State}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="{Binding ItemCount}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Style="{StaticResource SettingsSectionTitle}" 
                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_Title]}"/>
            <TextBlock Style="{StaticResource SettingsHintText}" 
                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_Hint]}"/>

            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_IndexStatus]}" 
                                   FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{Binding LocalDrive.IndexSummary}"
                                   Foreground="{DynamicResource TextSecondary2}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimarySettingsButton}" 
                                Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_RebuildBtn]}" 
                                Command="{Binding LocalDrive.RebuildCommand}" IsEnabled="{Binding LocalDrive.CanRebuild}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/><ColumnDefinition Width="80"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_HeaderDrive]}" 
                                   Foreground="{DynamicResource TextSecondary2}"/>
                        <TextBlock Grid.Column="2" 
                                   Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_HeaderFileSystem]}" 
                                   Foreground="{DynamicResource TextSecondary2}"/>
                        <TextBlock Grid.Column="3" 
                                   Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_HeaderStatus]}" 
                                   Foreground="{DynamicResource TextSecondary2}"/>
                        <TextBlock Grid.Column="4" 
                                   Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_HeaderItems]}" 
                                   Foreground="{DynamicResource TextSecondary2}"/>
                    </Grid>
                    
                    <!-- Empty Placeholder Item -->
                    <Border Background="{DynamicResource EmptyPlaceholderBackground}" BorderBrush="{DynamicResource EmptyPlaceholderBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="24,32" Margin="0,8,0,0"
                            Visibility="{Binding LocalDrive.IsLocalDrivesEmpty, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="{DynamicResource EmptyPlaceholderIcon}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding LocalDrive.DrivesPlaceholderText}" FontSize="13" Foreground="{DynamicResource TextSecondary2}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    
                    <ItemsControl ItemsSource="{Binding LocalDrive.LocalDrives}" ItemTemplate="{StaticResource LocalDriveTemplate}"/>
                </StackPanel>
            </Border>

            <!-- Permanently enabled indexing behavior. -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_UpdatePolicy]}" 
                               FontWeight="SemiBold" FontSize="13"  Margin="0,0,0,12"/>
                    
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource SuccessBadgeBackground}" Margin="0,0,12,0">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SuccessBadgeText}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_Policy1Title]}" 
                                       FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimary2}"/>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_Policy1Desc]}" 
                                       FontSize="11" Foreground="{DynamicResource TextSecondary2}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="{DynamicResource SuccessBadgeBackground}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_Permanent]}" 
                                       FontSize="10" Foreground="{DynamicResource SuccessBadgeText}" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                    
                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SettingsRowBorderBrush}" Margin="0,8"/>
                    
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource SuccessBadgeBackground}" Margin="0,0,12,0">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SuccessBadgeText}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_Policy2Title]}" 
                                       FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimary2}"/>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_Policy2Desc]}" 
                                       FontSize="11" Foreground="{DynamicResource TextSecondary2}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="{DynamicResource SuccessBadgeBackground}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_Permanent]}" 
                                       FontSize="10" Foreground="{DynamicResource SuccessBadgeText}" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                    
                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SettingsRowBorderBrush}" Margin="0,8"/>
                    
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource SuccessBadgeBackground}" Margin="0,0,12,0">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SuccessBadgeText}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_Policy3Title]}" 
                                       FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimary2}"/>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_Policy3Desc]}" 
                                       FontSize="11" Foreground="{DynamicResource TextSecondary2}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="{DynamicResource SuccessBadgeBackground}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Local_Permanent]}" 
                                       FontSize="10" Foreground="{DynamicResource SuccessBadgeText}" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
