<UserControl x:Class="SwiftList.App.Views.Settings.AboutSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:services="clr-namespace:SwiftList.App.Services"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SwiftList.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource SettingsSectionTitle}" 
                   Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[About_Title]}"/>
        <TextBlock Style="{StaticResource SettingsHintText}" 
                   Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[About_Hint]}"/>

        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[About_Desc1]}" 
                               FontSize="22" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI"/>
                    <TextBlock Text="{Binding AppVersion}" 
                               FontSize="14" Foreground="{DynamicResource TextSecondary2}" 
                               VerticalAlignment="Bottom" Margin="8,0,0,3"/>
                </StackPanel>
                <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[About_Desc2]}"
                           Foreground="{DynamicResource TextSecondary2}"
                           Margin="0,6,0,0"/>
                <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[About_Desc3]}"
                           Foreground="{DynamicResource TextSecondary2}"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0"/>
                <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[About_Desc4]}"
                           Foreground="{DynamicResource TextSecondary2}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
