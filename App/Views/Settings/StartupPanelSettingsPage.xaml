<UserControl x:Class="SwiftList.App.Views.Settings.StartupPanelSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:services="clr-namespace:SwiftList.App.Services"
             xmlns:conv="clr-namespace:SwiftList.App.Views.Converters"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="700">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SwiftList.App;component/Resources/Styles.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/SearchWindow.xaml"/>
                <ResourceDictionary Source="../../Resources/Styles/SettingsWindow.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True"/>

            <Style x:Key="RuleTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Height" Value="34"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style x:Key="RuleBulkTextBox" TargetType="TextBox" BasedOn="{StaticResource RuleTextBox}">
                <Setter Property="Height" Value="132"/>
                <Setter Property="AcceptsReturn" Value="True"/>
                <Setter Property="AcceptsTab" Value="True"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            </Style>

            <Style x:Key="RuleIconButton" TargetType="Button">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary2}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="DirectoryItemTemplate">
                <Border BorderBrush="{DynamicResource SettingsRowBorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"
                                   Foreground="{DynamicResource TextPrimary2}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="&#xE70F;"
                                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_EditTooltip]}"
                                    Style="{StaticResource RuleIconButton}"
                                    Command="{Binding DataContext.EditDirectoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="&#xE74D;"
                                    ToolTip="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_RemoveTooltip]}"
                                    Style="{StaticResource RuleIconButton}"
                                    Command="{Binding DataContext.RemoveDirectoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,0">
            <TextBlock Style="{StaticResource SettingsSectionTitle}"
                       Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Settings_StartupPanel]}"/>

            <CheckBox Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[StartupPanel_Enabled]}"
                      IsChecked="{Binding Enabled, Mode=TwoWay}"
                      Margin="0,12,0,0"/>

            <!-- Sub-tab header row (only "Recent Files" exists today; more tabs would each get their
                 own header here mirroring the live panel's own tabs) -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <StackPanel>
                    <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[StartupPanel_TabRecentFiles]}"
                            Command="{Binding SelectSubTabCommand}" CommandParameter="RecentFiles">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabHeaderButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSubTab}" Value="RecentFiles">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource TabUnderlineStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSubTab}" Value="RecentFiles">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>

                <StackPanel Margin="24,0,0,0">
                    <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[StartupPanel_TabPluginTabs]}"
                            Command="{Binding SelectSubTabCommand}" CommandParameter="PluginTabs">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabHeaderButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSubTab}" Value="PluginTabs">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource TabUnderlineStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSubTab}" Value="PluginTabs">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </StackPanel>
            </StackPanel>
            <Border Height="1" Background="{DynamicResource SettingsRowBorderBrush}" Margin="0,0,0,15"/>

            <!-- Sub-tab: Recent Files -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSubTab}" Value="RecentFiles">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <CheckBox Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[StartupPanel_RecentFilesEnabled]}"
                          IsChecked="{Binding RecentFilesEnabled, Mode=TwoWay}"
                          Margin="0,0,0,12"/>

                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[StartupPanel_RecentFilesDirectoriesDesc]}"
                                   Style="{StaticResource SettingsHintText}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right"
                                    Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_AddBtn]}"
                                    Style="{StaticResource PrimarySettingsButton}"
                                    Command="{Binding AddDirectoryCommand}" Margin="10,0,0,0"/>
                            <TextBox Style="{StaticResource RuleTextBox}"
                                     Text="{Binding NewDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding RecentFilesDirectories}" ItemTemplate="{StaticResource DirectoryItemTemplate}"/>
                        <TextBox Style="{StaticResource RuleBulkTextBox}" Margin="0,10,0,8"
                                 Text="{Binding DirectoriesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[Exclusions_ApplyBtn]}"
                                    Style="{StaticResource PrimarySettingsButton}"
                                    Command="{Binding ApplyDirectoriesTextCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCard}" Margin="0,15,0,0" Grid.IsSharedSizeScope="True">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="StartupPanelCountLabel"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[StartupPanel_RecentFilesCountDesc]}"
                                       Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Style="{StaticResource RuleTextBox}"
                                     Text="{Binding RecentFilesCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="StartupPanelCountLabel"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[StartupPanel_RecentFilesMaxAgeDesc]}"
                                       Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Style="{StaticResource RuleTextBox}"
                                     Text="{Binding RecentFilesMaxAgeMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnValidationError=True, ValidatesOnExceptions=True}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Sub-tab: Plugin Tabs -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSubTab}" Value="PluginTabs">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[StartupPanel_PluginTabsDesc]}"
                           Style="{StaticResource SettingsHintText}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                <TextBlock Text="{Binding Source={x:Static services:TranslationManager.Instance}, Path=[StartupPanel_PluginTabsEmpty]}"
                           Style="{StaticResource SettingsHintText}"
                           Visibility="{Binding HasPluginTabs, Converter={StaticResource InvertBoolToVis}}"/>

                <Border Style="{StaticResource SettingsCard}" Visibility="{Binding HasPluginTabs, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding PluginTabs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource SettingsRowBorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOpen, Mode=TwoWay}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
