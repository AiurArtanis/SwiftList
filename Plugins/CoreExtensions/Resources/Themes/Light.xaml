<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Theme Metadata -->
    <sys:String x:Key="ThemeId">Light</sys:String>
    <sys:Boolean x:Key="IsDark">False</sys:Boolean>
    <sys:Double x:Key="WindowOpacity">1.0</sys:Double>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SelectedBackground" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="FolderIconColor" Color="#D97706"/>
    <SolidColorBrush x:Key="FileIconColor" Color="#64748B"/>
    <SolidColorBrush x:Key="ShortcutColor" Color="#64748B"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="ControlHoverBackground" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="ControlDisabledBackground" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="ControlDisabledBorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ControlDisabledForeground" Color="#94A3B8"/>
    <SolidColorBrush x:Key="SpinnerTrackBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="MenuText" Color="#0F172A"/>
    <SolidColorBrush x:Key="MenuDisabledText" Color="#94A3B8"/>
    <SolidColorBrush x:Key="WindowChromeText" Color="#64748B"/>
    <SolidColorBrush x:Key="WindowControlHover" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ActionsHeaderBg" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SettingsCardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="SettingsRowBorderBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="HeaderColumnBg" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="HeaderColumnText" Color="#64748B"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SidebarHover" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="SidebarSelected" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="SidebarText" Color="#475569"/>
    <SolidColorBrush x:Key="SidebarTextActive" Color="#0F172A"/>
    <SolidColorBrush x:Key="SidebarAccent" Color="#3B82F6"/>
    <SolidColorBrush x:Key="ContentBg" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ItemHover" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="ItemSelected" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="AccentColor" Color="#3B82F6"/>
    <SolidColorBrush x:Key="TextPrimary2" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondary2" Color="#64748B"/>
    <SolidColorBrush x:Key="StatusBarBg" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="IconMutedBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="WarningBackground" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#FDE68A"/>
    <SolidColorBrush x:Key="BadgeBackground" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="BadgeBorderBrush" Color="#BFDBFE"/>
    <SolidColorBrush x:Key="BadgeText" Color="#2563EB"/>
    <SolidColorBrush x:Key="PrimaryButtonText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBackground" Color="#2563EB"/>
    <SolidColorBrush x:Key="PrimaryButtonPressedBackground" Color="#1D4ED8"/>
    
    <SolidColorBrush x:Key="SecondaryButtonText" Color="#475569"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverText" Color="#0F172A"/>

    <!-- Badges, status alerts & placeholders -->
    <SolidColorBrush x:Key="SuccessBadgeBackground" Color="#EFFDF5"/>
    <SolidColorBrush x:Key="SuccessBadgeBorderBrush" Color="#D1FAE5"/>
    <SolidColorBrush x:Key="SuccessBadgeText" Color="#059669"/>
    
    <SolidColorBrush x:Key="ErrorBackground" Color="#FEF2F2"/>
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444"/>

    <SolidColorBrush x:Key="EmptyPlaceholderBackground" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="EmptyPlaceholderBorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="EmptyPlaceholderIcon" Color="#94A3B8"/>

    <Color x:Key="ShadowColor">#000000</Color>

    <!-- Mapping of plugin hardcoded hex colors to dynamic theme brushes -->
    <SolidColorBrush x:Key="#333333" Color="#333333"/>
    <SolidColorBrush x:Key="#3A3A3A" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="#333" Color="#333333"/>

    <!-- Dynamic icon colors for sidebar and plugins -->
    <SolidColorBrush x:Key="VideoIconColor" Color="#EC4899"/>
    <SolidColorBrush x:Key="ArchiveIconColor" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="DefaultPluginIconColor" Color="#3B82F6"/>

    <!-- ScrollBar and CloseButton custom dynamic colors -->
    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="ScrollBarThumbHover" Color="#999999"/>
    <SolidColorBrush x:Key="ScrollBarThumbDragging" Color="#777777"/>
    <SolidColorBrush x:Key="CloseButtonHoverBg" Color="#E81123"/>
    <SolidColorBrush x:Key="CalculatorIconColor" Color="#107C41"/>

</ResourceDictionary>
