<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Theme Metadata -->
    <sys:String x:Key="ThemeId">Cyberpunk</sys:String>
    <sys:Boolean x:Key="IsDark">True</sys:Boolean>
    <sys:Double x:Key="WindowOpacity">0.85</sys:Double>

    <SolidColorBrush x:Key="CardBackground" Color="#0F0C1B"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2A1B4E"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#00FFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FF007F"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#00FFFF"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#1D123A"/>
    <SolidColorBrush x:Key="SelectedBackground" Color="#FF007F"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#2A1B4E"/>
    <SolidColorBrush x:Key="FolderIconColor" Color="#FFFF00"/>
    <SolidColorBrush x:Key="FileIconColor" Color="#00FFFF"/>
    <SolidColorBrush x:Key="ShortcutColor" Color="#00FFFF"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#07050F"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#2A1B4E"/>
    <SolidColorBrush x:Key="ControlHoverBackground" Color="#1D123A"/>
    <SolidColorBrush x:Key="ControlDisabledBackground" Color="#150F28"/>
    <SolidColorBrush x:Key="ControlDisabledBorderBrush" Color="#0F0C1B"/>
    <SolidColorBrush x:Key="ControlDisabledForeground" Color="#2A1B4E"/>
    <SolidColorBrush x:Key="SpinnerTrackBrush" Color="#2A1B4E"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#0F0C1B"/>
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#2A1B4E"/>
    <SolidColorBrush x:Key="MenuText" Color="#00FFFF"/>
    <SolidColorBrush x:Key="MenuDisabledText" Color="#2A1B4E"/>
    <SolidColorBrush x:Key="WindowChromeText" Color="#FF007F"/>
    <SolidColorBrush x:Key="WindowControlHover" Color="#1D123A"/>
    <SolidColorBrush x:Key="ActionsHeaderBg" Color="#150F28"/>
    <SolidColorBrush x:Key="SettingsCardBackground" Color="#0F0C1B"/>
    <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#2A1B4E"/>
    <SolidColorBrush x:Key="SettingsRowBorderBrush" Color="#1D123A"/>
    <SolidColorBrush x:Key="HeaderColumnBg" Color="#150F28"/>
    <SolidColorBrush x:Key="HeaderColumnText" Color="#FF007F"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#2A1B4E"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#150F28"/>
    <SolidColorBrush x:Key="SidebarHover" Color="#1D123A"/>
    <SolidColorBrush x:Key="SidebarSelected" Color="#FF007F"/>
    <SolidColorBrush x:Key="SidebarText" Color="#2A1B4E"/>
    <SolidColorBrush x:Key="SidebarTextActive" Color="#00FFFF"/>
    <SolidColorBrush x:Key="SidebarAccent" Color="#FFFF00"/>
    <SolidColorBrush x:Key="ContentBg" Color="#07050F"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#150F28"/>
    <SolidColorBrush x:Key="ItemHover" Color="#1D123A"/>
    <SolidColorBrush x:Key="ItemSelected" Color="#FF007F"/>
    <SolidColorBrush x:Key="BorderColor" Color="#2A1B4E"/>
    <SolidColorBrush x:Key="AccentColor" Color="#00FFFF"/>
    <SolidColorBrush x:Key="TextPrimary2" Color="#00FFFF"/>
    <SolidColorBrush x:Key="TextSecondary2" Color="#FF007F"/>
    <SolidColorBrush x:Key="StatusBarBg" Color="#150F28"/>
    <SolidColorBrush x:Key="IconMutedBrush" Color="#2A1B4E"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#39FF14"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFF00"/>
    <SolidColorBrush x:Key="WarningBackground" Color="#1C1A00"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#FFFF00"/>
    <SolidColorBrush x:Key="BadgeBackground" Color="#150F28"/>
    <SolidColorBrush x:Key="BadgeBorderBrush" Color="#2A1B4E"/>
    <SolidColorBrush x:Key="BadgeText" Color="#FFFF00"/>
    <SolidColorBrush x:Key="PrimaryButtonText" Color="#07050F"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBackground" Color="#00FFFF"/>
    <SolidColorBrush x:Key="PrimaryButtonPressedBackground" Color="#FF007F"/>
    
    <SolidColorBrush x:Key="SecondaryButtonText" Color="#FF007F"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverText" Color="#00FFFF"/>

    <!-- Badges, status alerts & placeholders -->
    <SolidColorBrush x:Key="SuccessBadgeBackground" Color="#0A1C0A"/>
    <SolidColorBrush x:Key="SuccessBadgeBorderBrush" Color="#39FF14"/>
    <SolidColorBrush x:Key="SuccessBadgeText" Color="#39FF14"/>
    
    <SolidColorBrush x:Key="ErrorBackground" Color="#21000A"/>
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#FF007F"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF007F"/>

    <SolidColorBrush x:Key="EmptyPlaceholderBackground" Color="#07050F"/>
    <SolidColorBrush x:Key="EmptyPlaceholderBorderBrush" Color="#2A1B4E"/>
    <SolidColorBrush x:Key="EmptyPlaceholderIcon" Color="#2A1B4E"/>

    <Color x:Key="ShadowColor">#FF007F</Color>

    <!-- Mapping of plugin hardcoded hex colors to dynamic theme brushes -->
    <SolidColorBrush x:Key="#333333" Color="#00FFFF"/>
    <SolidColorBrush x:Key="#3A3A3A" Color="#00FFFF"/>
    <SolidColorBrush x:Key="#333" Color="#00FFFF"/>

    <!-- Dynamic icon colors for sidebar and plugins -->
    <SolidColorBrush x:Key="VideoIconColor" Color="#FF007F"/>
    <SolidColorBrush x:Key="ArchiveIconColor" Color="#9D00FF"/>
    <SolidColorBrush x:Key="DefaultPluginIconColor" Color="#FFFF00"/>

    <!-- ScrollBar and CloseButton custom dynamic colors -->
    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#2A1B4E"/>
    <SolidColorBrush x:Key="ScrollBarThumbHover" Color="#00FFFF"/>
    <SolidColorBrush x:Key="ScrollBarThumbDragging" Color="#FF007F"/>
    <SolidColorBrush x:Key="CloseButtonHoverBg" Color="#FF007F"/>
    <SolidColorBrush x:Key="CalculatorIconColor" Color="#39FF14"/>

</ResourceDictionary>
