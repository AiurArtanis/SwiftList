<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Theme Metadata -->
    <sys:String x:Key="ThemeId">Dark</sys:String>
    <sys:Boolean x:Key="IsDark">True</sys:Boolean>
    <sys:Double x:Key="WindowOpacity">1.0</sys:Double>
    <SolidColorBrush x:Key="CardBackground" Color="#1E293B"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#334155"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#334155"/>
    <SolidColorBrush x:Key="SelectedBackground" Color="#2563EB"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#334155"/>
    <SolidColorBrush x:Key="FolderIconColor" Color="#F5A623"/>
    <SolidColorBrush x:Key="FileIconColor" Color="#94A3B8"/>
    <SolidColorBrush x:Key="ShortcutColor" Color="#64748B"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#0F172A"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#475569"/>
    <SolidColorBrush x:Key="ControlHoverBackground" Color="#1E293B"/>
    <SolidColorBrush x:Key="ControlDisabledBackground" Color="#1E293B"/>
    <SolidColorBrush x:Key="ControlDisabledBorderBrush" Color="#334155"/>
    <SolidColorBrush x:Key="ControlDisabledForeground" Color="#64748B"/>
    <SolidColorBrush x:Key="SpinnerTrackBrush" Color="#475569"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#1E293B"/>
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#334155"/>
    <SolidColorBrush x:Key="MenuText" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="MenuDisabledText" Color="#64748B"/>
    <SolidColorBrush x:Key="WindowChromeText" Color="#94A3B8"/>
    <SolidColorBrush x:Key="WindowControlHover" Color="#334155"/>
    <SolidColorBrush x:Key="ActionsHeaderBg" Color="#1E293B"/>
    <SolidColorBrush x:Key="SettingsCardBackground" Color="#1E293B"/>
    <SolidColorBrush x:Key="SettingsCardBorderBrush" Color="#334155"/>
    <SolidColorBrush x:Key="SettingsRowBorderBrush" Color="#334155"/>
    <SolidColorBrush x:Key="HeaderColumnBg" Color="#1E293B"/>
    <SolidColorBrush x:Key="HeaderColumnText" Color="#94A3B8"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#334155"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#0B0F19"/>
    <SolidColorBrush x:Key="SidebarHover" Color="#1E293B"/>
    <SolidColorBrush x:Key="SidebarSelected" Color="#2563EB"/>
    <SolidColorBrush x:Key="SidebarText" Color="#94A3B8"/>
    <SolidColorBrush x:Key="SidebarTextActive" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="SidebarAccent" Color="#3B82F6"/>
    <SolidColorBrush x:Key="ContentBg" Color="#0F172A"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#1E293B"/>
    <SolidColorBrush x:Key="ItemHover" Color="#334155"/>
    <SolidColorBrush x:Key="ItemSelected" Color="#2563EB"/>
    <!-- Dedicated accent-bar color: this theme's row-selection tint is already high-contrast against
         its hover fill, so the bar reuses it as-is. -->
    <SolidColorBrush x:Key="AccentBarColor" Color="#2563EB"/>
    <SolidColorBrush x:Key="BorderColor" Color="#1E293B"/>
    <SolidColorBrush x:Key="AccentColor" Color="#3B82F6"/>
    <SolidColorBrush x:Key="TextPrimary2" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TextSecondary2" Color="#94A3B8"/>
    <SolidColorBrush x:Key="StatusBarBg" Color="#0B0F19"/>
    <SolidColorBrush x:Key="IconMutedBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="WarningBackground" Color="#451A03"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#78350F"/>
    <SolidColorBrush x:Key="BadgeBackground" Color="#1E293B"/>
    <SolidColorBrush x:Key="BadgeBorderBrush" Color="#334155"/>
    <SolidColorBrush x:Key="BadgeText" Color="#3B82F6"/>
    <SolidColorBrush x:Key="PrimaryButtonText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBackground" Color="#2563EB"/>
    <SolidColorBrush x:Key="PrimaryButtonPressedBackground" Color="#1D4ED8"/>
    
    <SolidColorBrush x:Key="SecondaryButtonText" Color="#94A3B8"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverText" Color="#F8FAFC"/>

    <!-- Badges, status alerts & placeholders -->
    <SolidColorBrush x:Key="SuccessBadgeBackground" Color="#064E3B"/>
    <SolidColorBrush x:Key="SuccessBadgeBorderBrush" Color="#065F46"/>
    <SolidColorBrush x:Key="SuccessBadgeText" Color="#34D399"/>
    
    <SolidColorBrush x:Key="ErrorBackground" Color="#450A0A"/>
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#7F1D1D"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171"/>

    <SolidColorBrush x:Key="EmptyPlaceholderBackground" Color="#0F172A"/>
    <SolidColorBrush x:Key="EmptyPlaceholderBorderBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="EmptyPlaceholderIcon" Color="#475569"/>

    <Color x:Key="ShadowColor">#000000</Color>

    <!-- Mapping of plugin hardcoded hex colors to dynamic theme brushes -->
    <SolidColorBrush x:Key="#333333" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="#3A3A3A" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="#333" Color="#F8FAFC"/>

    <!-- Dynamic icon colors for sidebar and plugins -->
    <SolidColorBrush x:Key="VideoIconColor" Color="#F43F5E"/>
    <SolidColorBrush x:Key="ArchiveIconColor" Color="#A855F7"/>
    <SolidColorBrush x:Key="DefaultPluginIconColor" Color="#3B82F6"/>

    <!-- ScrollBar and CloseButton custom dynamic colors -->
    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#475569"/>
    <SolidColorBrush x:Key="ScrollBarThumbHover" Color="#64748B"/>
    <SolidColorBrush x:Key="ScrollBarThumbDragging" Color="#94A3B8"/>
    <SolidColorBrush x:Key="CloseButtonHoverBg" Color="#E81123"/>
    <SolidColorBrush x:Key="CalculatorIconColor" Color="#22C55E"/>

</ResourceDictionary>
