## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Original source: https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Re]leasePublic/
x64/
x86/
SDKRedistList.xml
[Bb]in/
[Oo]bj/
[Ll]ogs/
bin/
obj/
*.obj
*.bin
# Not a build artifact -- PinyinEngine's embedded pinyin lookup table (tracked source data).
!Plugins/PinyinAlias/Resources/pinyin.bin

# Visual Studio 2015/2017/2019/2022 cache directory
.vs/
# Generated user settings files
.vs/*/Settings/CurrentSettings.vssettings

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
/*.VisualState.xml

# Build Performance Diagnostics
*.opendb
*.db

# F# Auto-generated files
/*.formats

# JetBrains Rider
.idea/
*.sln.iml

# Visual Studio Code
.vscode/

# Local History for Visual Studio Code
.history/

# Windows image analyses
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Package Manager Recovers
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# StyleCop
StyleCop.Cache
StyleCop.ReSharper.Cache

# Backup & checkpoint files
*~
*.stackdump

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# App Local Log Files
*.log

# Scratch scripts and demo projects
scratch/
publish/

# Installer outputs
SwiftList-Setup.exe
SwiftList-Portable.zip

# VitePress site exclusions
Site/node_modules/
Site/.vitepress/dist/
Site/.vitepress/cache/
Site/public/
Site/.vitepress/public/logo.png
Site/.vitepress/public/favicon.ico

# Claude Code local project state (per-machine, not shared)
.claude/


