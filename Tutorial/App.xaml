<Application x:Class="SwiftList.Tutorial.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Premium Light Theme Colors -->
        <Color x:Key="ColorBg">#f4f6f9</Color>
        <Color x:Key="ColorCardBg">#ffffff</Color>
        <Color x:Key="ColorPrimary">#2563eb</Color>
        <Color x:Key="ColorText">#1f2937</Color>
        <Color x:Key="ColorTextMuted">#6b7280</Color>
        <Color x:Key="ColorGreen">#10b981</Color>
        <Color x:Key="ColorTitleBg">#eef2f7</Color>
        <Color x:Key="ColorBorder">#dcdfe6</Color>
        <Color x:Key="ColorButtonBg">#e5e7eb</Color>
        <Color x:Key="ColorButtonHoverBg">#d1d5db</Color>
        
        <SolidColorBrush x:Key="BrushBg" Color="{StaticResource ColorBg}"/>
        <SolidColorBrush x:Key="BrushCardBg" Color="{StaticResource ColorCardBg}"/>
        <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}"/>
        <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColorText}"/>
        <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>
        <SolidColorBrush x:Key="BrushGreen" Color="{StaticResource ColorGreen}"/>
        <SolidColorBrush x:Key="BrushTitleBg" Color="{StaticResource ColorTitleBg}"/>
        <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>
        <SolidColorBrush x:Key="BrushButtonBg" Color="{StaticResource ColorButtonBg}"/>
        <SolidColorBrush x:Key="BrushButtonHoverBg" Color="{StaticResource ColorButtonHoverBg}"/>
    </Application.Resources>
</Application>
